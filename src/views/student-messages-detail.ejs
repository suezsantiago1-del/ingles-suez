<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Devoluciones - <%= course.titulo %></title>
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>

    <%- include('partials/header') %>

    <div id="messages-container" class="flex flex-col md:flex-row min-h-screen w-full" data-active="<%= !!activeLessonId %>" style="height: calc(100vh - 120px); overflow:hidden;">
        <!-- Sidebar (always present on desktop) -->
        <aside id="messages-sidebar" class="w-full md:w-80 bg-white border-r border-slate-200 flex-shrink-0" style="padding:1.5rem; overflow:auto;">
            <h2 style="color:var(--primary-navy); font-weight:900; margin-bottom:1rem;"> <%= course.titulo %> </h2>
            <nav>
                <div style="display:block;">
                <% lessons.forEach(lesson => { %>
                    <% const isActive = (lesson.id == activeLessonId); %>
                    <% const activePill = isActive ? 'rounded-lg mx-2 my-2 bg-[#002244] text-white px-4 py-2' : ''; %>
                    <% const separatorClass = isActive ? '' : 'border-b border-slate-200'; %>

                    <% if (lesson.isLocked) { %>
                        <div class="opacity-50 <%= activePill %> <%= separatorClass %>" style="display:flex; align-items:center; gap:0.6rem;">
                            <span style="font-weight:700; color:<%= isActive ? '#fff' : '#94a3b8' %>;">🔒</span>
                            <span style="color:<%= isActive ? '#fff' : '#94a3b8' %>;"> <%= lesson.orden %>. <%= lesson.titulo %></span>
                        </div>
                    <% } else { %>
                        <a href="?lessonId=<%= lesson.id %>" class="block text-inherit <%= activePill %> <%= separatorClass %>" style="text-decoration:none;">
                            <div style="display:flex; align-items:center; justify-content:space-between; padding:0.5rem 0;">
                                <div style="display:flex; gap:0.6rem; align-items:center;">
                                    <span style="font-weight:700; color:<%= isActive ? '#fff' : 'var(--primary-navy)' %>;"><%= lesson.orden %>.</span>
                                    <span style="color:<%= isActive ? '#fff' : 'inherit' %>"><%= lesson.titulo %></span>
                                </div>
                            </div>
                        </a>
                    <% } %>
                <% }) %>
                </div>
            </nav>
        </aside>

        <!-- Content -->
        <section id="messages-content" class="flex-1 p-6 md:p-8 bg-slate-100" style="overflow:auto;">
            <!-- Mobile back button (visible only on mobile) -->
            <button id="back-to-list-btn" class="block md:hidden" style="background:none; border:none; color:#002244; font-weight:700; margin-bottom:1rem;">← Volver a la lista</button>
            <% if (!activeLessonId) { %>
                <div style="text-align:center; color:var(--text-muted); margin-top:4rem;">
                    <h3 style="color:var(--primary-navy);">Selecciona una clase para ver la devolución</h3>
                    <p>Elige una lección desbloqueada en la columna izquierda.</p>
                </div>
            <% } else { %>
                <div style="max-width:900px; margin:0 auto;">
                    <h2 style="color:var(--primary-navy); margin-bottom:0.5rem;">Devoluciones - Clase seleccionada</h2>

                    <% if (messages && messages.length > 0) { %>
                        <% messages.forEach(m => { %>
                            <div class="msg-card" style="margin-bottom:1rem;">
                                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.5rem;">
                                    <div style="color:var(--text-muted); font-size:0.9rem;">Enviado: <%= new Date(m.fecha).toLocaleString('es-AR') %></div>
                                    <% if (m.nota !== null && m.nota !== undefined) { %>
                                        <div class="nota-badge">Calif: <%= m.nota %>/10</div>
                                    <% } %>
                                </div>

                                <div class="bubble-student">
                                    <strong style="display:block; color:#0b2238; margin-bottom:0.35rem;">Tu entrega enviada</strong>
                                    <div style="color:#334155;"><%= m.entrega_alumno %></div>
                                </div>

                                <div class="bubble-teacher" style="margin-top:0.75rem;">
                                    <strong style="display:block; color:var(--accent-blue); margin-bottom:0.35rem;">Devolución del Profesor</strong>
                                    <div style="color:#0f172a;"><%= m.mensaje %></div>
                                </div>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <div class="messages-empty">No hay devoluciones registradas para esta clase.</div>
                    <% } %>
                </div>
            <% } %>
        </section>
    </div>

    <%- include('partials/footer') %>
    <script>
        (function(){
            const container = document.getElementById('messages-container');
            const sidebar = document.getElementById('messages-sidebar');
            const content = document.getElementById('messages-content');
            const backBtn = document.getElementById('back-to-list-btn');
            const hasActive = container && container.dataset && container.dataset.active === 'true';

            function isMobile() { return window.innerWidth < 768; }

            function applyResponsive() {
                if (!sidebar || !content) return;
                if (isMobile()) {
                    // Mobile: show either sidebar (list) or content (chat)
                    if (hasActive) {
                        sidebar.classList.add('hidden');
                        content.classList.remove('hidden');
                        if (backBtn) backBtn.classList.remove('hidden');
                    } else {
                        sidebar.classList.remove('hidden');
                        content.classList.add('hidden');
                        if (backBtn) backBtn.classList.add('hidden');
                    }
                } else {
                    // Desktop: always show both columns
                    sidebar.classList.remove('hidden');
                    content.classList.remove('hidden');
                    if (backBtn) backBtn.classList.add('hidden');
                }
            }

            window.addEventListener('resize', applyResponsive);
            document.addEventListener('DOMContentLoaded', applyResponsive);
            applyResponsive();

            if (backBtn) {
                backBtn.addEventListener('click', function(e){
                    e.preventDefault();
                    if (isMobile()) {
                        sidebar.classList.remove('hidden');
                        content.classList.add('hidden');
                        history.pushState(null, '', '/messages/<%= course.id %>');
                    } else {
                        sidebar.scrollIntoView({ behavior: 'smooth' });
                    }
                });
            }
        })();
    </script>

</body>
</html>