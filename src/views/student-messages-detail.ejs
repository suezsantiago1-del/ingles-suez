<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Devoluciones - <%= course.titulo %></title>
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>

    <%- include('partials/header') %>

    <div class="h-screen" style="display:flex; height: calc(100vh - 120px); overflow:hidden;">
        <!-- Sidebar -->
        <aside style="width:25%; background:#f8fafc; padding:1.25rem; overflow:auto; border-right:1px solid #e6eef6;">
            <h2 style="color:var(--primary-navy); font-weight:900; margin-bottom:1rem;"> <%= course.titulo %> </h2>
            <nav>
                <% lessons.forEach(lesson => { %>
                    <% if (lesson.isLocked) { %>
                        <div class="mb-2 opacity-50" style="padding:0.6rem 0.75rem; border-radius:6px; display:flex; align-items:center; gap:0.6rem;">
                            <span style="font-weight:700; color:#94a3b8;">🔒</span>
                            <span style="color:#94a3b8;"><%= lesson.orden %>. <%= lesson.titulo %></span>
                        </div>
                    <% } else { %>
                        <a href="?lessonId=<%= lesson.id %>" class="mb-2" style="display:block; padding:0.6rem 0.75rem; border-radius:6px; text-decoration:none; color:inherit;">
                            <div style="display:flex; align-items:center; justify-content:space-between;">
                                <div style="display:flex; gap:0.6rem; align-items:center;">
                                    <span style="font-weight:700; color:var(--primary-navy);"><%= lesson.orden %>.</span>
                                    <span><%= lesson.titulo %></span>
                                </div>
                                <% if (lesson.id == activeLessonId) { %>
                                    <div style="border-left:4px solid #002244; height:26px; margin-left:1rem;"></div>
                                <% } %>
                            </div>
                        </a>
                    <% } %>
                <% }) %>
            </nav>
        </aside>

        <!-- Content -->
        <section style="width:75%; padding:2rem; overflow:auto; background:white;">
            <% if (!activeLessonId) { %>
                <div style="text-align:center; color:var(--text-muted); margin-top:4rem;">
                    <h3 style="color:var(--primary-navy);">Selecciona una clase para ver la devolución</h3>
                    <p>Elige una lección desbloqueada en la columna izquierda.</p>
                </div>
            <% } else { %>
                <div style="max-width:900px; margin:0 auto;">
                    <h2 style="color:var(--primary-navy); margin-bottom:0.5rem;">Devoluciones - Clase seleccionada</h2>

                    <% if (messages && messages.length > 0) { %>
                        <% messages.forEach(m => { %>
                            <div class="msg-card" style="margin-bottom:1rem;">
                                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.5rem;">
                                    <div style="color:var(--text-muted); font-size:0.9rem;">Enviado: <%= new Date(m.fecha).toLocaleString('es-AR') %></div>
                                    <% if (m.nota !== null && m.nota !== undefined) { %>
                                        <div class="nota-badge">Calif: <%= m.nota %>/10</div>
                                    <% } %>
                                </div>

                                <div class="bubble-student">
                                    <strong style="display:block; color:#0b2238; margin-bottom:0.35rem;">Tu entrega enviada</strong>
                                    <div style="color:#334155;"><%= m.entrega_alumno %></div>
                                </div>

                                <div class="bubble-teacher" style="margin-top:0.75rem;">
                                    <strong style="display:block; color:var(--accent-blue); margin-bottom:0.35rem;">Devolución del Profesor</strong>
                                    <div style="color:#0f172a;"><%= m.mensaje %></div>
                                </div>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <div class="messages-empty">No hay devoluciones registradas para esta clase.</div>
                    <% } %>
                </div>
            <% } %>
        </section>
    </div>

    <%- include('partials/footer') %>
</body>
</html>