<!DOCTYPE html>
<html lang="es">
<head>
    <link rel="icon" type="image/svg+xml" href="/img/favicon-suez.svg">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Devoluciones · <%= course.titulo %> · Inglés Suez</title>
</head>
<body class="tema-flyer">
    <%- include('partials/header') %>

    <% const activa = (lessons || []).find(l => l.id == activeLessonId); %>

    <main class="fx-page">
        <a href="/messages" class="fx-back">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M15 6l-6 6 6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Mis mensajes
        </a>
        <h1 class="fx-page__title" style="margin-top: 1rem;"><%= course.titulo %></h1>

        <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
            <p class="fx-status is-error"><%= errorMessage %></p>
        <% } %>

        <div class="fx-msgs">
            <!-- Clases del curso -->
            <nav class="fx-lessons" aria-label="Clases del curso">
                <% (lessons || []).forEach(lesson => { const on = lesson.id == activeLessonId; %>
                    <% if (lesson.isLocked) { %>
                        <span class="fx-lesson is-locked" title="Se habilita al completar la clase anterior">
                            <span class="fx-lesson__n"><%= lesson.orden %></span>
                            <span class="fx-lesson__t"><%= lesson.titulo %></span>
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-label="Bloqueada"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>
                        </span>
                    <% } else { %>
                        <a href="/messages/<%= course.id %>?lessonId=<%= lesson.id %>" class="fx-lesson" <%- on ? 'aria-current="page"' : '' %>>
                            <span class="fx-lesson__n"><%= lesson.orden %></span>
                            <span class="fx-lesson__t"><%= lesson.titulo %></span>
                        </a>
                    <% } %>
                <% }) %>
            </nav>

            <!-- Devoluciones de la clase elegida -->
            <section aria-live="polite">
                <% if (activa) { %>
                    <h2 class="fx-msgs__title">Clase <%= activa.orden %>: <%= activa.titulo %></h2>

                    <% if (messages && messages.length > 0) { %>
                        <% messages.forEach(m => { %>
                            <article class="fx-feedback">
                                <header class="fx-feedback__head">
                                    <span class="fx-feedback__who">
                                        <span class="fx-avatar" aria-hidden="true">S</span>
                                        <span>Devolución del profesor<small><%= new Date(m.fecha).toLocaleString('es-AR', { day: 'numeric', month: 'long', hour: '2-digit', minute: '2-digit' }) %></small></span>
                                    </span>
                                    <% if (m.nota !== null && m.nota !== undefined) { %>
                                        <span class="fx-grade" aria-label="Nota <%= m.nota %>"><small>Nota</small><%= m.nota %></span>
                                    <% } %>
                                </header>
                                <p class="fx-feedback__body"><%= m.mensaje %></p>
                                <details class="fx-feedback__mine">
                                    <summary>Ver lo que entregaste</summary>
                                    <p><%= m.entrega_alumno %></p>
                                </details>
                            </article>
                        <% }) %>
                    <% } else { %>
                        <div class="fx-panel" style="text-align: center; padding: 2.5rem 1.5rem;">
                            <h2>Todavía no hay devolución</h2>
                            <p style="margin: 0 0 1.2rem;">Si ya entregaste esta clase, el profesor la está corrigiendo. Si no, podés hacerla desde el aula.</p>
                            <a href="/classroom/<%= course.id %>" class="fx-btn fx-btn--sm">Ir al aula</a>
                        </div>
                    <% } %>
                <% } else { %>
                    <div class="fx-panel" style="text-align: center; padding: 2.5rem 1.5rem;">
                        <h2>Este curso todavía no tiene clases</h2>
                        <p style="margin: 0;">Cuando se publiquen, vas a ver acá las devoluciones de cada una.</p>
                    </div>
                <% } %>
            </section>
        </div>
    </main>

    <%- include('partials/footer') %>

    <script>
    // En celular, la lista de clases es una fila deslizable: centrar la clase activa
    (function () {
        var on = document.querySelector('.fx-lesson[aria-current="page"]');
        if (on && window.matchMedia('(max-width: 860px)').matches) on.scrollIntoView({ block: 'nearest', inline: 'center' });
    })();
    </script>
</body>
</html>
