<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Panel del Profesor - Entregas de Alumnos</title>
    <link rel="stylesheet" href="/css/styles.css">
    <style>
        .container-panel { max-width: 1000px; margin: 3rem auto; padding: 0 1.5rem; }
        .entrega-card { background: #ffffff; border: 1px solid #cbd5e0; border-radius: 8px; padding: 1.5rem; margin-bottom: 1.5rem; box-shadow: 0 2px 8px rgba(0,0,0,0.05); }
        .badge { background: #e2ebd5; color: #184168; padding: 0.2rem 0.6rem; border-radius: 4px; font-size: 0.8rem; font-weight: bold; }
    </style>
</head>
<body>

    <%- include('partials/header') %>

    <main class="container-panel">
        <h1 style="color: #0b2238;">Entregas de Alumnos</h1>
        <p style="color: #4a5568;">Revisa las respuestas de los trabajos prácticos de tus estudiantes:</p>

        <% if (entregas && entregas.length > 0) { %>
            <% entregas.forEach(e => { %>
                <div class="entrega-card">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.8rem; border-bottom: 1px solid #edf2f7; padding-bottom: 0.5rem;">
                        <div>
                            <strong style="color: #0b2238; font-size: 1.1rem;"><%= e.usuario_nombre %></strong> 
                            <span style="color: #718096; font-size: 0.85rem;">(<%= e.usuario_email %>)</span>
                        </div>
                        <span style="color: #718096; font-size: 0.85rem;"><%= new Date(e.fecha).toLocaleString('es-AR') %></span>
                    </div>

                    <div style="margin-bottom: 0.8rem;">
                        <span class="badge"><%= e.curso_titulo %></span>
                        <span style="color: #4a5568; font-size: 0.9rem; margin-left: 0.5rem;"><strong>Clase:</strong> <%= e.leccion_titulo %></span>
                    </div>

                    <div style="background: #f7fafc; padding: 1rem; border-left: 4px solid #184168; border-radius: 4px; color: #2d3748; white-space: pre-wrap;">
                        <%= e.contenido %>
                    </div>
                </div>
            <% }); %>
        <% } else { %>
            <p style="color: #718096;">Aún no hay entregas registradas por parte de los alumnos.</p>
        <% } %>
    </main>

    <%- include('partials/footer') %>

</body>
</html>