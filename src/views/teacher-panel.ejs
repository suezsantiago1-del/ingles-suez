<!DOCTYPE html>
<html lang="es">
<head>
    <link rel="icon" type="image/svg+xml" href="/img/favicon-suez.svg">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Entregas · Panel del profesor · Inglés Suez</title>
</head>
<body class="tema-flyer">

    <%- include('partials/header') %>

    <%
        // Agrupar entregas por alumno (renderizado en el servidor: EJS escapa todo lo que escribió el alumno)
        const lista = typeof entregas !== 'undefined' && Array.isArray(entregas) ? entregas : [];
        const alumnos = [];
        const porId = new Map();
        lista.forEach(e => {
            if (!porId.has(e.usuario_id)) {
                const a = { id: e.usuario_id, nombre: e.usuario_nombre, email: e.usuario_email, entregas: [], pendientes: 0 };
                porId.set(e.usuario_id, a);
                alumnos.push(a);
            }
            const a = porId.get(e.usuario_id);
            a.entregas.push(e);
            if (!e.devolucion_mensaje) a.pendientes++;
        });
        // Primero quienes tienen entregas sin corregir
        alumnos.sort((x, y) => (y.pendientes > 0) - (x.pendientes > 0));
        const totalPendientes = alumnos.reduce((s, a) => s + a.pendientes, 0);
        const fecha = (f) => f ? new Date(f).toLocaleString('es-AR', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }) : '';
        const inicial = (n) => (n || '?').trim().charAt(0).toUpperCase();
        const tieneNota = (n) => n !== null && n !== undefined;
    %>

    <main class="fx-page">
        <%- include('partials/teacher-tabs', { activa: '/profesor/entregas' }) %>

        <div class="fx-block__head" style="margin: 2.2rem 0 0;">
            <h1 class="fx-page__title">Entregas <span class="fx-steel">de cursos</span></h1>
            <p><%= totalPendientes === 0 ? 'Estás al día: no hay entregas sin corregir.' : (totalPendientes === 1 ? 'Hay 1 entrega esperando corrección.' : 'Hay ' + totalPendientes + ' entregas esperando corrección.') %></p>
        </div>

        <% if (alumnos.length === 0) { %>
            <div class="fx-panel" style="margin-top: 2rem; text-align: center; padding: 3rem 1.5rem;">
                <h2>Todavía no hay entregas</h2>
                <p style="margin: 0;">Cuando un alumno entregue una clase, la vas a ver acá para corregirla.</p>
            </div>
        <% } else { %>
        <div class="fx-chat" id="fx-chat">
            <aside class="fx-chat__side">
                <div class="fx-chat__side-head" style="flex-wrap: wrap;">
                    <input type="search" class="fx-input" id="fx-buscar" placeholder="Buscar alumno" aria-label="Buscar alumno" style="padding: 0.55rem 0.9rem; border-radius: 999px;">
                </div>
                <ul class="fx-chat__list" role="tablist" aria-label="Alumnos">
                    <% alumnos.forEach(a => { %>
                        <li data-nombre="<%= ((a.nombre || '') + ' ' + (a.email || '')).toLowerCase() %>">
                            <button type="button" class="fx-chat__item fx-chat__item--avatar" role="tab" data-consulta="<%= a.id %>" aria-selected="false">
                                <span class="fx-avatar" aria-hidden="true"><%= inicial(a.nombre) %></span>
                                <span style="min-width: 0;">
                                    <span class="fx-chat__item-top">
                                        <span class="fx-chat__item-name"><%= a.nombre %></span>
                                        <% if (a.pendientes > 0) { %><span class="fx-badge-count" title="Sin corregir"><%= a.pendientes %></span><% } %>
                                    </span>
                                    <span class="fx-chat__item-prev" style="display: block;"><%= a.entregas.length %> <%= a.entregas.length === 1 ? 'entrega' : 'entregas' %><%= a.pendientes > 0 ? ' · ' + a.pendientes + ' sin corregir' : ' · al día' %></span>
                                </span>
                            </button>
                        </li>
                    <% }) %>
                </ul>
                <p class="fx-chat__empty-list" id="fx-lista-vacia" hidden>No hay alumnos con ese nombre.</p>
            </aside>

            <div class="fx-chat__main">
                <div class="fx-chat__blank" id="fx-blank">Elegí un alumno para ver y corregir sus entregas.</div>
                <% alumnos.forEach(a => { %>
                    <div class="fx-chat__conv" data-consulta="<%= a.id %>" role="tabpanel" style="display: none; flex-direction: column; flex: 1; min-height: 0;">
                        <div class="fx-chat__head">
                            <button type="button" class="fx-chat__back" aria-label="Volver a la lista">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 6l-6 6 6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                            </button>
                            <span class="fx-avatar" aria-hidden="true"><%= inicial(a.nombre) %></span>
                            <span style="min-width: 0;">
                                <span class="fx-chat__head-title" style="display: block;"><%= a.nombre %></span>
                                <a href="mailto:<%= a.email %>" class="fx-chat__head-meta" style="text-decoration: none;"><%= a.email %></a>
                            </span>
                        </div>

                        <div class="fx-entregas">
                            <% a.entregas.forEach(e => { const corregida = !!e.devolucion_mensaje; %>
                                <article class="fx-entrega<%= corregida ? '' : ' is-pendiente' %>">
                                    <header class="fx-entrega__head">
                                        <div>
                                            <span class="fx-tag"><%= e.curso_titulo %></span>
                                            <h3><%= e.leccion_titulo %></h3>
                                        </div>
                                        <span class="fx-entrega__fecha"><%= fecha(e.fecha) %></span>
                                    </header>

                                    <div class="fx-entrega__resp">
                                        <span>Respuesta del alumno</span>
                                        <p><%= e.contenido %></p>
                                    </div>

                                    <% if (corregida) { %>
                                        <div class="fx-entrega__dev">
                                            <div>
                                                <span>Tu devolución · <%= fecha(e.devolucion_fecha) %></span>
                                                <p><%= e.devolucion_mensaje %></p>
                                            </div>
                                            <% if (tieneNota(e.devolucion_nota)) { %>
                                                <span class="fx-grade"><small>Nota</small><%= e.devolucion_nota %></span>
                                            <% } %>
                                        </div>
                                    <% } %>

                                    <details class="fx-entrega__form" <%= corregida ? '' : 'open' %>>
                                        <summary><%= corregida ? 'Editar devolución' : 'Corregir esta entrega' %></summary>
                                        <div class="fx-field">
                                            <label for="dev-text-<%= e.id %>">Devolución para el alumno</label>
                                            <textarea class="fx-input" id="dev-text-<%= e.id %>" rows="4" placeholder="Correcciones y comentarios"><%= e.devolucion_mensaje || '' %></textarea>
                                        </div>
                                        <div class="fx-entrega__row">
                                            <div class="fx-field" style="margin: 0;">
                                                <label for="dev-nota-<%= e.id %>">Nota (1 a 10)</label>
                                                <input class="fx-input" type="number" id="dev-nota-<%= e.id %>" min="1" max="10" placeholder="8" value="<%= tieneNota(e.devolucion_nota) ? e.devolucion_nota : '' %>" style="width: 110px;">
                                            </div>
                                            <button type="button" class="fx-btn fx-btn--solid fx-btn--sm" onclick="enviarDevolucion(<%= e.id %>, <%= e.usuario_id %>, this)"><%= corregida ? 'Actualizar devolución' : 'Enviar devolución' %></button>
                                        </div>

                                        <div class="fx-field" style="margin-top: 1.3rem;">
                                            <label for="teacher-note-<%= e.id %>">Nota del profesor (la ve el alumno en el aula)</label>
                                            <textarea class="fx-input" id="teacher-note-<%= e.id %>" rows="2" placeholder="Un consejo o aviso para el alumno"><%= e.teacher_notes || '' %></textarea>
                                        </div>
                                        <button type="button" class="fx-btn fx-btn--sm" onclick="enviarNotaProfesor(<%= e.id %>, this)">Guardar nota</button>
                                    </details>
                                </article>
                            <% }) %>
                        </div>
                    </div>
                <% }) %>
            </div>
        </div>
        <% } %>
    </main>

    <%- include('partials/footer') %>

    <script>
        // Lista de alumnos: elegir, buscar y volver en celular
        (function () {
            var chat = document.getElementById('fx-chat');
            if (!chat) return;
            var items = Array.prototype.slice.call(chat.querySelectorAll('.fx-chat__list li'));
            function abrir(id, enMovil) {
                if (enMovil) chat.classList.add('is-thread');
                document.getElementById('fx-blank').style.display = 'none';
                chat.querySelectorAll('.fx-chat__item').forEach(function (b) { b.setAttribute('aria-selected', b.dataset.consulta === id ? 'true' : 'false'); });
                chat.querySelectorAll('.fx-chat__conv').forEach(function (c) { c.style.display = c.dataset.consulta === id ? 'flex' : 'none'; });
                if (enMovil) window.scrollTo(0, chat.offsetTop - 80);
            }
            chat.querySelectorAll('.fx-chat__item').forEach(function (b) {
                b.addEventListener('click', function () { abrir(b.dataset.consulta, window.matchMedia('(max-width: 860px)').matches); });
            });
            chat.querySelectorAll('.fx-chat__back').forEach(function (b) {
                b.addEventListener('click', function () { chat.classList.remove('is-thread'); });
            });
            var buscar = document.getElementById('fx-buscar');
            buscar.addEventListener('input', function () {
                var q = buscar.value.trim().toLowerCase();
                var visibles = 0;
                items.forEach(function (li) { li.hidden = q && li.dataset.nombre.indexOf(q) === -1; if (!li.hidden) visibles++; });
                document.getElementById('fx-lista-vacia').hidden = visibles > 0;
            });
            // En escritorio, abrir el primer alumno de la lista
            if (!window.matchMedia('(max-width: 860px)').matches && items.length) abrir(items[0].querySelector('button').dataset.consulta, false);
        })();

        async function enviarDevolucion(entregaId, usuarioId, btn) {
            const textarea = document.getElementById(`dev-text-${entregaId}`);
            const inputNota = document.getElementById(`dev-nota-${entregaId}`);
            
            const mensaje = textarea.value.trim();
            const nota = inputNota ? inputNota.value.trim() : null;

            if (!mensaje) {
                alert('Escribe una devolución antes de enviar.');
                return;
            }

            if (nota !== "" && (isNaN(nota) || parseInt(nota) < 1 || parseInt(nota) > 10)) {
                alert('Por favor, ingresa una nota válida entre 1 y 10.');
                return;
            }

            const textoOriginal = btn.innerText;
            btn.innerText = 'Guardando...';
            btn.disabled = true;

            try {
                const response = await fetch('/profesor/devolucion', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ entregaId, usuarioId, mensaje, nota })
                });

                const data = await response.json();

                if (data.success) {
                    alert('¡Devolución enviada correctamente al alumno!');
                    window.location.reload();
                } else {
                    alert(data.message || 'Error al guardar la devolución.');
                    btn.innerText = textoOriginal;
                    btn.disabled = false;
                }
            } catch (err) {
                console.error(err);
                alert('Error de conexión al enviar la devolución.');
                btn.innerText = textoOriginal;
                btn.disabled = false;
            }
        }

        // Save teacher note for an entrega
        async function enviarNotaProfesor(entregaId, btn) {
            const textarea = document.getElementById(`teacher-note-${entregaId}`);
            if (!textarea) return;

            const note = textarea.value.trim();

            const originalText = btn.innerText;
            btn.innerText = 'Guardando...';
            btn.disabled = true;

            try {
                const response = await fetch('/profesor/nota', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ entregaId, note })
                });

                const data = await response.json();
                if (data.success) {
                    alert('Nota del profesor guardada correctamente.');
                    btn.innerText = 'Guardado';
                    setTimeout(() => { btn.innerText = originalText; }, 1200);
                } else {
                    alert(data.message || 'Error al guardar la nota del profesor.');
                    btn.innerText = originalText;
                }
            } catch (err) {
                console.error(err);
                alert('Error de conexión al guardar la nota del profesor.');
                btn.innerText = originalText;
            } finally {
                btn.disabled = false;
            }
        }

    </script>

</body>
</html>