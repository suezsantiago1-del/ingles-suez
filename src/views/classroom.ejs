<!DOCTYPE html>
<html lang="es">
<head>
    <link rel="icon" type="image/svg+xml" href="/img/favicon-suez.svg">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= leccionActiva ? leccionActiva.titulo : 'Aula virtual' %> · Inglés Suez</title>
    <style>
        /* Contenido de la lección: hoja clara dentro del aula oscura (el HTML de las clases trae sus propios estilos claros) */
        .leccion-body { background: #F6F7F9; color: #1a202c; border-radius: 22px; padding: 2.2rem; font-family: 'Archivo', system-ui, sans-serif; line-height: 1.6; }
        .leccion-body h1, .leccion-body h2, .leccion-body h3, .leccion-body h4 { color: #0D1420; }
        .leccion-body a { color: #1E4D77; }
        .leccion-bienvenida { text-align: center; font-size: 1.2rem; line-height: 1.85; animation: bienvenidaEntrada 0.9s ease-out both; }
        .leccion-bienvenida h2 { font-size: 2rem; font-style: italic; font-weight: 900; text-transform: uppercase; margin: 0 0 1.2rem; }
        .leccion-bienvenida .clase-contenido { background: transparent; box-shadow: none; border: none; padding: 0; }
        @keyframes bienvenidaEntrada { from { opacity: 0; transform: translateY(24px); } to { opacity: 1; transform: none; } }

        /* Opciones de los ejercicios dentro de la lección */
        .option-btn { display: block; width: 100%; text-align: left; background: #fff; border: 1px solid #cbd5e0; padding: 0.75rem 1rem; margin-bottom: 0.5rem; border-radius: 12px; cursor: pointer; font-size: 0.95rem; transition: background 0.2s, border-color 0.2s; color: #1a202c; }
        .option-btn:hover { background: #edf2f7; border-color: #8FADD6; }
        .option-btn.selected-correct { background: #c6f6d5 !important; border-color: #38a169 !important; color: #22543d !important; font-weight: bold; }
        .option-btn.selected-incorrect { background: #fed7d7 !important; border-color: #e53e3e !important; color: #742a2a !important; font-weight: bold; }

        @media (max-width: 768px) {
            .leccion-body { padding: 1.4rem 1.1rem; border-radius: 18px; }
            .leccion-bienvenida { font-size: 1.05rem; }
            .leccion-bienvenida h2 { font-size: 1.5rem; }
        }
    </style>

    <!-- Google AdSense Verification -->
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-1854686112404128"
         crossorigin="anonymous"></script>
</head>
<body class="tema-flyer">

    <%- include('partials/header') %>

    <!-- Notificación Toast Floater -->
    <div id="toast-notification" class="toast-notification" role="status">
        <div>
            <strong>¡Entrega registrada!</strong>
            <span>Procesando…</span>
        </div>
    </div>

    <div class="classroom-container">
        <!-- Clases del curso -->
        <aside class="sidebar-lessons" aria-label="Clases del curso">
            <a href="/mis-cursos" class="fx-aula__back">← Mis cursos</a>
            <h3><%= curso.titulo %></h3>
            <p class="fx-aula__modulo"><%= leccionActiva ? leccionActiva.modulo : '' %></p>

            <div class="fx-aula__list">
                <% lecciones.forEach(l => { %>
                    <% const esBienvenida = (l.orden === 0); %>
                    <% const fullLabel = esBienvenida ? l.titulo : `Clase ${l.orden}: ${l.titulo}`; %>
                    <% if (l.desbloqueada) { %>
                        <a href="/classroom/<%= curso.id %>?leccion=<%= l.id %>" class="lesson-item <%= (leccionActiva && leccionActiva.id == l.id) ? 'active' : '' %>" title="<%= fullLabel %>" aria-label="<%= fullLabel %>" <%- (leccionActiva && leccionActiva.id == l.id) ? 'aria-current="page"' : '' %>>
                            <span class="lesson-item__n"><%= esBienvenida ? '★' : l.orden %></span>
                            <span class="lesson-item__t"><%= esBienvenida ? 'Welcome!' : l.titulo %></span>
                            <% if (l.completada) { %>
                                <svg class="lesson-item__ok" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-label="Completada"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>
                            <% } %>
                        </a>
                    <% } else { %>
                        <div class="lesson-item disabled" title="<%= l.orden === 10 ? 'Requiere aprobación del profesor en todas las entregas previas' : 'Completá la entrega de la clase anterior para desbloquearla' %>">
                            <span class="lesson-item__n"><%= l.orden %></span>
                            <span class="lesson-item__t"><%= l.titulo %><% if (l.orden === 10) { %><small>Requiere aprobar las clases 1 a 9</small><% } %></span>
                            <svg class="lesson-item__lock" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-label="Bloqueada"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>
                        </div>
                    <% } %>
                <% }); %>
            </div>
        </aside>

        <!-- Área principal -->
        <main class="main-content">
            <% if (leccionActiva && leccionActiva.orden !== 0) { %>
                <span class="fx-auth__eyebrow">Clase <%= leccionActiva.orden %></span>
            <% } %>
            <h1 class="fx-aula__title"><%= leccionActiva ? leccionActiva.titulo : '' %></h1>

            <!-- Anuncio del curso (visible para todos los alumnos) -->
            <% if (anuncios && anuncios.length > 0) { %>
                <div class="fx-aula__note fx-aula__note--anuncio">
                    <strong>Anuncio del curso</strong>
                    <p><%= anuncios[0].mensaje %></p>
                </div>
            <% } %>

            <!-- Certificado (solo al aprobar la Clase 10) -->
            <% if (leccionActiva && leccionActiva.orden === 10 && leccionActiva.nota !== null && leccionActiva.nota !== undefined && leccionActiva.nota >= 7) { %>
                <div class="certificado-banner">
                    <h2>¡Felicitaciones, terminaste el curso!</h2>
                    <p>Aprobaste la evaluación final con <strong><%= leccionActiva.nota %>/10</strong>.</p>
                    <a href="/classroom/<%= curso.id %>/certificado" class="fx-btn fx-btn--solid">Descargar mi certificado (PDF)</a>
                </div>
            <% } %>

            <!-- Estado de la entrega de esta clase -->
            <% if (leccionActiva) { %>
                <% if (leccionActiva.nota !== null && leccionActiva.nota !== undefined) { %>
                    <% if (leccionActiva.nota >= 7) { %>
                        <div class="fx-aula__estado is-ok">
                            <span class="fx-grade" aria-label="Nota <%= leccionActiva.nota %>"><small>Nota</small><%= leccionActiva.nota %></span>
                            <div><strong>Entrega aprobada</strong><p>Ya cumpliste todo lo de esta clase.</p></div>
                        </div>
                    <% } else { %>
                        <div class="fx-aula__estado is-error">
                            <span class="fx-grade" aria-label="Nota <%= leccionActiva.nota %>"><small>Nota</small><%= leccionActiva.nota %></span>
                            <div><strong>Tenés que rehacer la entrega</strong><p>Mirá la devolución del profesor en <a href="/messages/<%= curso.id %>?lessonId=<%= leccionActiva.id %>">Mis mensajes</a> y volvé a enviar tu respuesta abajo.</p></div>
                        </div>
                    <% } %>
                <% } else if (leccionActiva.completada) { %>
                    <div class="fx-aula__estado">
                        <span class="fx-aula__dot" aria-hidden="true"></span>
                        <div><strong>Entrega enviada, en revisión</strong><p>El profesor la está corrigiendo. Te avisamos en Mis mensajes.</p></div>
                    </div>
                <% } %>
                <% if (leccionActiva.teacher_notes) { %>
                    <div class="fx-aula__note">
                        <strong>Nota del profesor</strong>
                        <p><%= leccionActiva.teacher_notes %></p>
                    </div>
                <% } %>
                <% if (leccionActiva.teacher_note) { %>
                    <div class="fx-aula__note">
                        <strong>Mensaje del profesor sobre esta clase</strong>
                        <p><%= leccionActiva.teacher_note %></p>
                    </div>
                <% } %>
            <% } %>

            <!-- Video (no va en la lección Welcome!, orden 0) -->
            <% if (leccionActiva && leccionActiva.orden !== 0) { %>
            <div class="video-container">
                <% if (leccionActiva && leccionActiva.video_url) { %>
                    <% const url = leccionActiva.video_url; %>
                    <% const isMp4 = url.toLowerCase().endsWith('.mp4') || url.includes('/videos/'); %>
                    <% const isYouTube = url.includes('youtube.com') || url.includes('youtu.be') || url.includes('youtube-nocookie.com'); %>

                    <% if (isMp4) { %>
                        <video width="100%" height="100%" controls playsinline style="background: #000;">
                            <source src="<%= url %>" type="video/mp4">
                            Tu navegador no soporta el elemento de video.
                        </video>
                    <% } else if (isYouTube) { %>
                        <iframe width="100%" height="100%" src="<%= url %>" frameborder="0" allowfullscreen></iframe>
                    <% } else { %>
                        <iframe width="100%" height="100%" src="<%= url %>" frameborder="0" allowfullscreen></iframe>
                    <% } %>
                <% } else { %>
                    <div class="video-placeholder">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="9.5"/><path d="M10 8.5l5.5 3.5-5.5 3.5z" fill="currentColor"/></svg>
                        <strong>Video de la clase</strong>
                        <span>Muy pronto en esta lección</span>
                    </div>
                <% } %>
            </div>
            <% } %>

            <!-- Contenido interactivo -->
            <div class="leccion-body <%= (leccionActiva && leccionActiva.orden === 0) ? 'leccion-bienvenida' : '' %>">
                <% if (leccionActiva && leccionActiva.orden === 0) { %>
                    <img src="/img/logo.jpg" alt="INGLÉS SUEZ" style="max-width: 150px; display: block; margin: 0 auto 1.5rem auto; border-radius: 8px;">
                <% } %>
                <% if (leccionActiva && leccionActiva.nota !== null && leccionActiva.nota !== undefined && leccionActiva.nota < 7) { %>
                    <!-- Botón global de rehacer: único punto para volver a intentar cuando la nota es < 7 -->
                    <div id="rehacerEjerciciosWrap" style="display: flex; justify-content: flex-end; margin-bottom: 1.5rem;">
                        <button type="button" id="btnRehacerEjercicios" style="background: #0D1420; color: white; border: none; padding: 0.7rem 1.4rem; border-radius: 999px; font-weight: bold; cursor: pointer; font-size: 0.95rem;">
                            Rehacer ejercicios
                        </button>
                    </div>
                <% } %>
                <%- leccionActiva ? leccionActiva.contenido_html : '' %>
            </div>

            <!-- Consultas al profesor (no va en la lección Welcome!, orden 0) -->
            <% if (leccionActiva && leccionActiva.orden !== 0) { %>
            <section class="fx-panel fx-aula__consultas">
                <h2>Consultas al profesor</h2>
                <p>¿Te quedó alguna duda de esta clase? Escribila y el profesor te responde acá.</p>

                <div id="lista-consultas">
                    <% if (consultas && consultas.length > 0) { %>
                        <% consultas.forEach(c => { %>
                            <div class="fx-aula__consulta">
                                <div class="fx-aula__consulta-head">
                                    <strong>Tu consulta</strong>
                                    <span><%= new Date(c.fecha).toLocaleString('es-AR', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }) %></span>
                                </div>
                                <p><%= c.mensaje %></p>
                                <% if (c.respuesta_profesor) { %>
                                    <div class="fx-aula__respuesta">
                                        <strong>Respuesta del profesor</strong>
                                        <p><%= c.respuesta_profesor %></p>
                                        <span><%= new Date(c.fecha_respuesta).toLocaleString('es-AR', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }) %></span>
                                    </div>
                                <% } else { %>
                                    <p class="fx-aula__espera">Esperando respuesta del profesor…</p>
                                <% } %>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <p class="fx-aula__vacio">Todavía no hiciste consultas en esta clase.</p>
                    <% } %>
                </div>

                <label for="textarea-consulta" class="fx-sr">Tu consulta</label>
                <textarea id="textarea-consulta" class="fx-input" rows="3" placeholder="Escribí tu consulta…"></textarea>
                <button type="button" id="btn-enviar-consulta" class="fx-btn fx-btn--solid fx-btn--sm" onclick="enviarConsulta()">Enviar consulta</button>
            </section>
            <% } %>
        </main>
    </div>

    <%- include('partials/footer') %>

    <!-- Script de Interactividad para los Quizzes y Revisiones -->
    <script>
        // Definir funciones globalmente para asegurar disponibilidad inmediata
        console.log('Inicializando funciones del classroom...');
        
        // Función para respuestas de multiple choice - definida directamente en window
        window.checkAnswer = function(button, isCorrect, feedbackId, explanationText) {
            console.log('checkAnswer llamado:', { isCorrect, feedbackId, explanationText });
            
            try {
                const container = button.closest('.quiz-question');
                if (!container) {
                    console.error('No se encontró el contenedor .quiz-question');
                    return;
                }
                
                const buttons = container.querySelectorAll('.option-btn');
                const feedbackBox = document.getElementById(feedbackId);

                if (!feedbackBox) {
                    console.error('No se encontró el feedback box con ID:', feedbackId);
                    return;
                }

                if (isCorrect) {
                    // Respuesta correcta: limpiar selecciones incorrectas, deshabilitar todos los botones
                    buttons.forEach(btn => {
                        btn.classList.remove('selected-incorrect');
                        btn.disabled = true;
                    });
                    button.classList.add('selected-correct');
                    feedbackBox.style.display = 'block';
                    feedbackBox.style.background = '#f0fff4';
                    feedbackBox.style.border = '1px solid #c6f6d5';
                    feedbackBox.style.color = '#22543d';
                    feedbackBox.innerHTML = '<strong>Respuesta Correcta.</strong> ' + explanationText;
                    
                    // Marcar el contenedor como completado
                    container.dataset.completed = 'true';
                    
                    // Guardar la respuesta correcta para que persista tras recargar la página
                    window.guardarRespuestaQuiz(feedbackId, feedbackBox.innerHTML);
                } else {
                    // Respuesta incorrecta: deshabilitar solo este botón, permitir cambiar a otra opción
                    button.disabled = true;
                    button.classList.add('selected-incorrect');
                    feedbackBox.style.display = 'block';
                    feedbackBox.style.background = '#fff5f5';
                    feedbackBox.style.border = '1px solid #feb2b2';
                    feedbackBox.style.color = '#9b2c2c';
                    feedbackBox.innerHTML = '<strong>Respuesta Incorrecta.</strong> ' + explanationText;
                }
            } catch (error) {
                console.error('Error en checkAnswer:', error);
            }
        };
        
        // Guarda en localStorage (clave por lección) los ids de las preguntas de multiple
        // choice respondidas correctamente, junto con el texto de feedback mostrado.
        // Así la respuesta correcta queda "marcada" de forma permanente y sobrevive a recargas.
        window.guardarRespuestaQuiz = function (feedbackId, feedbackHtml) {
            const leccionId = "<%- leccionActiva ? leccionActiva.id : '' %>";
            if (!leccionId || !feedbackId) return;
            const key = 'quiz_respuestas_' + leccionId;
            let guardadas = {};
            try { guardadas = JSON.parse(localStorage.getItem(key) || '{}'); } catch (e) { guardadas = {}; }
            guardadas[feedbackId] = feedbackHtml;
            try { localStorage.setItem(key, JSON.stringify(guardadas)); } catch (e) { console.error('No se pudo persistir la respuesta: ', e); }
        };

        // Al cargar la página re-marcamos como respondidas (correctas) las preguntas ya guardadas.
        window.aplicarRespuestasGuardadas = function () {
            const leccionId = "<%- leccionActiva ? leccionActiva.id : '' %>";
            if (!leccionId) return;
            let guardadas = {};
            try { guardadas = JSON.parse(localStorage.getItem('quiz_respuestas_' + leccionId) || '{}'); } catch (e) { guardadas = {}; }
            const ids = Object.keys(guardadas);
            if (ids.length === 0) return;

            document.querySelectorAll('.quiz-question').forEach(container => {
                const btns = container.querySelectorAll('.option-btn');
                let btnCorrecto = null;
                let pregId = null;
                btns.forEach(btn => {
                    const oc = btn.getAttribute('onclick') || '';
                    const match = oc.match(/checkAnswer\(this,\s*true,\s*'([^']+)'/);
                    if (match) { btnCorrecto = btn; pregId = match[1]; }
                });
                if (!btnCorrecto || !pregId || !guardadas[pregId]) return;

                btns.forEach(btn => { btn.disabled = true; btn.classList.remove('selected-incorrect'); });
                btnCorrecto.classList.add('selected-correct');
                container.dataset.completed = 'true';
                const box = document.getElementById(pregId);
                if (box) {
                    box.style.display = 'block';
                    box.style.background = '#f0fff4';
                    box.style.border = '1px solid #c6f6d5';
                    box.style.color = '#22543d';
                    box.innerHTML = guardadas[pregId];
                }
            });
        };

        console.log('Función checkAnswer definida en window');

        // Envío de consultas al profesor por lección
        window.enviarConsulta = async function () {
            const textarea = document.getElementById('textarea-consulta');
            const contenido = textarea ? textarea.value.trim() : '';
            if (!contenido) {
                alert('Escribe tu consulta antes de enviarla.');
                return;
            }
            const btn = document.getElementById('btn-enviar-consulta');
            const cursoId = "<%- curso.id %>";
            const leccionId = "<%- leccionActiva ? leccionActiva.id : '' %>";
            if (btn) { btn.disabled = true; }
            try {
                const response = await fetch('/consultas/leccion', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ cursoId, leccionId, mensaje: contenido })
                });
                const data = await response.json();
                if (data.success) {
                    alert('Consulta enviada. El profesor te va a responder.');
                    window.location.reload();
                } else {
                    alert(data.message || 'No se pudo enviar la consulta.');
                    if (btn) { btn.disabled = false; }
                }
            } catch (error) {
                console.error('Error enviando consulta:', error);
                alert('Error de conexión al enviar tu consulta.');
                if (btn) { btn.disabled = false; }
            }
        };



            // Manejador del envío de revisión manual
            window.submitRevision = async function(btn) {
                console.log('submitRevision llamado');
                
                try {
                    const parentSection = btn.closest('section') || btn.parentElement;
                    const textarea = parentSection ? parentSection.querySelector('textarea') : null;

                    if (textarea && textarea.value.trim() === '') {
                        alert('Por favor, escribe tu respuesta o proyecto antes de enviar.');
                        return;
                    }

                    const cursoId = "<%- curso.id %>";
                    const leccionId = "<%- leccionActiva ? leccionActiva.id : '' %>";
                    const contenido = textarea ? textarea.value.trim() : '';

                    const originalText = btn.innerText;
                    btn.innerText = 'Enviando...';
                    btn.disabled = true;

                    try {
                        const response = await fetch('/entregas', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ cursoId, leccionId, contenido })
                        });

                        const data = await response.json();

                        if (data.success) {
                            btn.innerText = 'Enviado';
                            btn.style.background = '#718096';
                            btn.style.cursor = 'not-allowed';

                            if (textarea) {
                                textarea.disabled = true;
                                textarea.style.backgroundColor = '#edf2f7';
                            }

                            const toast = document.getElementById('toast-notification');
                            if (toast) toast.classList.add('show');
                            
                            setTimeout(() => {
                                window.location.reload();
                            }, 1500);
                        } else {
                            alert(data.message || 'Ocurrió un error al guardar tu entrega.');
                            btn.innerText = originalText;
                            btn.disabled = false;
                        }
                    } catch (error) {
                        console.error('Error enviando la entrega:', error);
                        alert('Hubo un error de conexión al enviar tu respuesta.');
                        btn.innerText = originalText;
                        btn.disabled = false;
                    }
                } catch (error) {
                    console.error('Error en submitRevision:', error);
                    alert('Error al procesar el envío.');
                }
            };
            
            console.log('Funciones definidas correctamente');

        // Vincular funciones y bloqueos según el estado de la entrega
        document.addEventListener('DOMContentLoaded', () => {
            console.log('DOM Content Loaded - Iniciando vinculación de botones');
            
            // Esperar un momento para asegurar que el contenido HTML está completamente renderizado
            setTimeout(() => {
                console.log('Iniciando vinculación de botones después de delay');
                
                // Restaurar las respuestas correctas ya guardadas (multiple choice persistente)
                window.aplicarRespuestasGuardadas();
                
                // El botón de envío del entregable es el ÚLTIMO botón dentro de
                // .leccion-body (la sección de entregable es el bloque final).
                // Así los botones de multiple choice quedan intactos.
                const btnsLeccion = document.querySelectorAll('.leccion-body button');
                const btnSubmit = btnsLeccion[btnsLeccion.length - 1];
                console.log('Total de botones en la lección:', btnsLeccion.length);

                if (btnSubmit) {
                    // Vincular el envío SOLO al botón del entregable
                    btnSubmit.removeAttribute('onclick');
                    btnSubmit.addEventListener('click', function(e) {
                        e.preventDefault();
                        e.stopPropagation();
                        console.log('Click en botón de envío:', btnSubmit.innerText);
                        window.submitRevision(this);
                    });
                }

                // Lógica de deshabilitado dinámico
                const notaRaw = <%- JSON.stringify((leccionActiva && leccionActiva.nota !== null && leccionActiva.nota !== undefined) ? leccionActiva.nota : '') %>;
                const nota = notaRaw !== "" ? parseInt(notaRaw, 10) : -1;
                const estaEnviadaSinNota = <%- JSON.stringify((leccionActiva && leccionActiva.completada && (leccionActiva.nota === null || leccionActiva.nota === undefined)) ? true : false) %>;
                const NOTA_APROBACION = 7;

                console.log('Estado de entrega:', { nota, estaEnviadaSinNota });

                // Guardar textos/estilos originales del entregable para poder restaurarlos al rehacer.
                const textareaEntrega = document.querySelector('.leccion-body textarea');
                const textareaPlaceholderOrig = textareaEntrega ? textareaEntrega.placeholder : '';
                const submitTextOrig = btnSubmit ? btnSubmit.innerText : '';
                const submitBgOrig = btnSubmit ? btnSubmit.style.background : '';

                if (nota >= NOTA_APROBACION || estaEnviadaSinNota) {
                    // APROBADO (>= 7) o EN REVISIÓN: se bloquea solo el entregable; el multiple choice queda intacto.
                    if (textareaEntrega) {
                        textareaEntrega.disabled = true;
                        textareaEntrega.placeholder = nota >= NOTA_APROBACION
                            ? "Entregable / Proyecto Aprobado."
                            : "Entrega enviada, en proceso de revisión...";
                        textareaEntrega.style.backgroundColor = "#edf2f7";
                    }

                    if (btnSubmit) {
                        btnSubmit.disabled = true;
                        btnSubmit.innerText = nota >= NOTA_APROBACION ? 'APROBADO' : 'EN REVISIÓN';
                        btnSubmit.style.background = nota >= NOTA_APROBACION ? '#38a169' : '#718096';
                        btnSubmit.style.cursor = 'not-allowed';
                    }
                } else if (nota !== -1 && nota < NOTA_APROBACION) {
                    // REPROBADO (< 7): se bloquea TODO (multiple choice + entregable) hasta reiniciar.
                    // Solo se modifica el estado disabled; los textos de las opciones quedan como están.
                    document.querySelectorAll('.leccion-body .option-btn').forEach(b => { b.disabled = true; });

                    if (textareaEntrega) {
                        textareaEntrega.disabled = true;
                        textareaEntrega.style.backgroundColor = "#edf2f7";
                    }
                    if (btnSubmit) {
                        btnSubmit.disabled = true;
                        btnSubmit.style.cursor = 'not-allowed';
                    }

                    const btnRehacer = document.getElementById('btnRehacerEjercicios');
                    if (btnRehacer) {
                        btnRehacer.addEventListener('click', () => {
                            // Al rehacer, limpiar las respuestas guardadas para empezar de cero
                            const leccionIdRehacer = "<%- leccionActiva ? leccionActiva.id : '' %>";
                            if (leccionIdRehacer) { localStorage.removeItem('quiz_respuestas_' + leccionIdRehacer); }

                            // Desbloquear y reiniciar el multiple choice
                            document.querySelectorAll('.leccion-body .quiz-question').forEach(pregunta => {
                                pregunta.querySelectorAll('.option-btn').forEach(b => {
                                    b.disabled = false;
                                    b.classList.remove('selected-correct', 'selected-incorrect');
                                });
                                const feedback = pregunta.querySelector('div[id]');
                                if (feedback) { feedback.style.display = 'none'; feedback.innerHTML = ''; }
                            });

                            // Reiniciar el entregable final para un nuevo intento
                            if (textareaEntrega) {
                                textareaEntrega.disabled = false;
                                textareaEntrega.value = '';
                                textareaEntrega.placeholder = textareaPlaceholderOrig;
                                textareaEntrega.style.backgroundColor = '';
                            }
                            if (btnSubmit) {
                                btnSubmit.disabled = false;
                                btnSubmit.innerText = submitTextOrig;
                                btnSubmit.style.background = submitBgOrig;
                                btnSubmit.style.cursor = 'pointer';
                            }

                            // Ocultar el botón global de rehacer
                            const wrap = document.getElementById('rehacerEjerciciosWrap');
                            if (wrap) wrap.remove();
                        });
                    }
                }
                
                console.log('Inicialización completada');
            }, 1000); // Aumentado a 1000ms para asegurar renderizado completo
        });

        // Agregar event listener global para capturar todos los clicks
        document.addEventListener('click', function(e) {
            const button = e.target.closest('button');
            if (!button) return;
            
            console.log('Click en botón detectado:', button.innerText);
            
            // Verificar si es un botón de multiple choice con onclick inline
            const onclick = button.getAttribute('onclick');
            if (onclick) {
                console.log('Botón tiene onclick:', onclick);
                if (onclick.includes('checkAnswer')) {
                    console.log('Es un botón de multiple choice, ejecutando onclick...');
                    // No prevenir el comportamiento, dejar que el onclick se ejecute
                }
            }
        }, true); // Use capture phase
    </script>
    <script>
    // En celular, centrar la clase activa en la fila deslizable
    (function () {
        var on = document.querySelector('.lesson-item.active');
        if (on && window.matchMedia('(max-width: 768px)').matches) on.scrollIntoView({ block: 'nearest', inline: 'center' });
    })();
    </script>
</body>
</html>