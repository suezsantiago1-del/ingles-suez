<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= leccionActiva ? leccionActiva.titulo : 'Aula Virtual' %> - INGLÉS SUEZ</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=GFS+Didot&family=Tenor+Sans&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/styles.css">
    <style>
        body { background-color: #f4f7f6; margin: 0; font-family: system-ui, -apple-system, sans-serif; }
        .classroom-container { display: flex; min-height: calc(100vh - 80px); }
        
        /* Sidebar de Lecciones */
        .sidebar-lessons { width: 320px; background: #0b2238; color: white; padding: 1.5rem; flex-shrink: 0; }
        .sidebar-lessons h3 { font-family: 'Tenor Sans', sans-serif; font-size: 1.1rem; color: #a4c4de; border-bottom: 1px solid #184168; padding-bottom: 0.8rem; }
        .lesson-item { display: flex; align-items: center; justify-content: space-between; padding: 0.8rem 1rem; color: #cbd5e0; text-decoration: none; border-radius: 6px; margin-bottom: 0.5rem; transition: background 0.2s; }
        .lesson-item:hover, .lesson-item.active { background: #184168; color: white; font-weight: bold; }
        .lesson-item.disabled { color: #64748b; background: rgba(255, 255, 255, 0.03); cursor: not-allowed; pointer-events: none; }
        
        /* Contenido Principal */
        .main-content { flex-grow: 1; padding: 2rem 3rem; max-width: 900px; }
        .video-container { background: #000; width: 100%; aspect-ratio: 16/9; border-radius: 10px; overflow: hidden; display: flex; align-items: center; justify-content: center; margin-bottom: 2rem; color: white; box-shadow: 0 10px 25px rgba(0,0,0,0.15); }
        .video-placeholder { text-align: center; color: #a4c4de; }
        
        /* Estilos de Botones y Opciones Interactivas */
        .option-btn {
            display: block;
            width: 100%;
            text-align: left;
            background: #f7fafc;
            border: 1px solid #cbd5e0;
            padding: 0.75rem 1rem;
            margin-bottom: 0.5rem;
            border-radius: 6px;
            cursor: pointer;
            font-size: 0.95rem;
            transition: background 0.2s, border-color 0.2s;
        }
        .option-btn:hover {
            background: #edf2f7;
            border-color: #a0aec0;
        }
        .option-btn.selected-correct {
            background: #c6f6d5 !important;
            border-color: #38a169 !important;
            color: #22543d !important;
            font-weight: bold;
        }
        .option-btn.selected-incorrect {
            background: #fed7d7 !important;
            border-color: #e53e3e !important;
            color: #742a2a !important;
            font-weight: bold;
        }

        /* Componente Notificación Push Toast */
        .toast-notification {
            position: fixed;
            bottom: 30px;
            right: 30px;
            background: #0b2238;
            color: #ffffff;
            border-left: 5px solid #38a169;
            padding: 1rem 1.5rem;
            border-radius: 8px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.25);
            display: flex;
            align-items: center;
            gap: 12px;
            z-index: 9999;
            opacity: 0;
            transform: translateY(20px);
            transition: all 0.3s ease-in-out;
            pointer-events: none;
        }
        .toast-notification.show {
            opacity: 1;
            transform: translateY(0);
        }

        @media (max-width: 768px) {
            .classroom-container { flex-direction: column; }
            .sidebar-lessons { width: 100%; }
            .main-content { padding: 1rem; }
            .toast-notification { left: 15px; right: 15px; bottom: 15px; }
        }
    </style>
</head>
<body>

    <%- include('partials/header') %>

    <!-- Notificación Toast Floater -->
    <div id="toast-notification" class="toast-notification">
        <span style="font-size: 1.2rem;">✅</span>
        <div>
            <strong style="display: block; font-size: 0.95rem;">¡Entregable Registrado!</strong>
            <span style="font-size: 0.85rem; color: #a4c4de;">Desbloqueando siguiente clase...</span>
        </div>
    </div>

    <div class="classroom-container">
        <!-- Sidebar -->
        <aside class="sidebar-lessons">
            <h3><%= curso.titulo %></h3>
            <p style="font-size: 0.85rem; color: #85abc9;"><%= leccionActiva ? leccionActiva.modulo : '' %></p>
            
            <div style="margin-top: 1.5rem;">
                <% lecciones.forEach(l => { %>
                    <% if (l.desbloqueada) { %>
                        <a href="/classroom/<%= curso.id %>?leccion=<%= l.id %>" class="lesson-item <%= (leccionActiva && leccionActiva.id == l.id) ? 'active' : '' %>">
                            <span>📖 <%= l.titulo %></span>
                            <% if (l.completada) { %> 
                                <span title="Clase completada">✅</span> 
                            <% } %>
                        </a>
                    <% } else { %>
                        <div class="lesson-item disabled" title="Completa la entrega de la clase anterior para desbloquear">
                            <span>🔒 <%= l.titulo %></span>
                        </div>
                    <% } %>
                <% }); %>
            </div>
        </aside>

        <!-- Área Principal de Aprendizaje -->
        <main class="main-content">
            <h1 style="font-family: 'Tenor Sans', sans-serif; color: #0b2238;"><%= leccionActiva.titulo %></h1>

            <!-- Reproductor de Video -->
            <div class="video-container">
                <% if (leccionActiva.video_url) { %>
                    <iframe width="100%" height="100%" src="<%= leccionActiva.video_url %>" frameborder="0" allowfullscreen></iframe>
                <% } else { %>
                    <div class="video-placeholder">
                        <div style="font-size: 3rem; margin-bottom: 0.5rem;">🎬</div>
                        <h3>Video Explicativo de la Clase</h3>
                        <p style="font-size: 0.9rem;">(Próximamente disponible en esta lección)</p>
                    </div>
                <% } %>
            </div>

            <!-- Contenido Interactivo -->
            <div class="leccion-body">
                <%- leccionActiva.contenido_html %>
            </div>
        </main>
    </div>

    <%- include('partials/footer') %>

    <!-- Script de Interactividad para los Quizzes y Revisiones -->
    <script>
        function checkAnswer(button, isCorrect, feedbackId, explanationText) {
            const container = button.closest('.quiz-question');
            const buttons = container.querySelectorAll('.option-btn');
            const feedbackBox = document.getElementById(feedbackId);

            // Deshabilitar todos los botones de la pregunta
            buttons.forEach(btn => btn.disabled = true);

            if (isCorrect) {
                button.classList.add('selected-correct');
                feedbackBox.style.display = 'block';
                feedbackBox.style.background = '#f0fff4';
                feedbackBox.style.border = '1px solid #c6f6d5';
                feedbackBox.style.color = '#22543d';
                feedbackBox.innerHTML = '<strong>Respuesta Correcta.</strong> ' + explanationText;
            } else {
                button.classList.add('selected-incorrect');
                feedbackBox.style.display = 'block';
                feedbackBox.style.background = '#fff5f5';
                feedbackBox.style.border = '1px solid #feb2b2';
                feedbackBox.style.color = '#9b2c2c';
                feedbackBox.innerHTML = '<strong>Respuesta Incorrecta.</strong> ' + explanationText;
            }
        }

        // Manejador del envío de revisión manual con guardado en la Base de Datos
        async function submitRevision(btn) {
            const parentSection = btn.closest('section') || btn.parentElement;
            const textarea = parentSection ? parentSection.querySelector('textarea') : null;

            if (textarea && textarea.value.trim() === '') {
                alert('Por favor, escribe tu respuesta antes de enviar.');
                return;
            }

            const cursoId = "<%= curso.id %>";
            const leccionId = "<%= leccionActiva ? leccionActiva.id : '' %>";
            const contenido = textarea ? textarea.value.trim() : '';

            // Estado visual temporal durante el envío
            const originalText = btn.innerText;
            btn.innerText = 'Enviando...';
            btn.disabled = true;

            try {
                const response = await fetch('/entregas', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ cursoId, leccionId, contenido })
                });

                const data = await response.json();

                if (data.success) {
                    // Cambiar estado permanente del botón
                    btn.innerText = 'Enviado';
                    btn.style.background = '#718096';
                    btn.style.cursor = 'not-allowed';

                    // Deshabilitar la caja de texto
                    if (textarea) {
                        textarea.disabled = true;
                        textarea.style.backgroundColor = '#edf2f7';
                    }

                    // Lanzar notificación push (toast)
                    const toast = document.getElementById('toast-notification');
                    toast.classList.add('show');
                    
                    // Recargar la página automáticamente para desbloquear la siguiente lección
                    setTimeout(() => {
                        window.location.reload();
                    }, 1500);
                } else {
                    alert(data.message || 'Ocurrió un error al guardar tu entrega.');
                    btn.innerText = originalText;
                    btn.disabled = false;
                }
            } catch (error) {
                console.error('Error enviando la entrega:', error);
                alert('Hubo un error de conexión al enviar tu respuesta.');
                btn.innerText = originalText;
                btn.disabled = false;
            }
        }

        // Vincular la función automáticamente a los botones de revisión al cargar la página
        document.addEventListener('DOMContentLoaded', () => {
            const buttons = document.querySelectorAll('button');
            buttons.forEach(btn => {
                const text = btn.innerText.toUpperCase();
                if (text.includes('ENVIAR A REVISIÓN') || text.includes('ENVIAR A REVISIÓN MANUAL')) {
                    btn.setAttribute('onclick', 'submitRevision(this)');
                }
            });
        });
    </script>
</body>
</html>