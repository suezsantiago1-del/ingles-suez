<!DOCTYPE html>
<html lang="es">
<head>
    <link rel="icon" type="image/svg+xml" href="/img/favicon-suez.svg">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Desafío del día · Inglés Suez</title>
</head>
<body class="tema-flyer">

<%- include('partials/header') %>

<main class="fx-page fx-reto">
    <div class="fx-reto__head">
        <span class="fx-auth__eyebrow">Cambia todos los días a las 20 h</span>
        <h1 class="fx-page__title">Desafío <span class="fx-steel">del día</span></h1>
    </div>

    <div class="fx-reto__layout<%= usuario ? '' : ' is-solo' %>">
        <div>
            <% if (desafio) { %>
            <section id="desafio-del-dia" class="fx-reto__card">
                <div class="fx-reto__top">
                    <h2>Resolvé el desafío de hoy</h2>
                    <span id="desafio-categoria" class="fx-tag"><%= ({ quiz: 'Quiz', situacion: 'Situación conversacional', error: 'Detectá el error', real: 'English real', conversacion: 'Completar conversación', dificil: 'Desafío difícil', listening: 'Listening', listening_corto: 'Escuchá y elegí' })[desafio.tipo] || desafio.categoria %></span>
                </div>

                <div id="desafio-contenido">
                    <p class="fx-reto__q"><%= desafio.pregunta %></p>
                    <% if (desafio.tipo === 'listening' || desafio.tipo === 'listening_corto') { %>
                    <div class="fx-reto__audio">
                        <button type="button" id="btn-escuchar" class="fx-btn fx-btn--solid fx-btn--sm" onclick="reproducirAudio()">Escuchar</button>
                        <span id="escuchar-ayuda">Escuchá la frase antes de responder.</span>
                    </div>
                    <% } %>
                    <div class="desafio-opciones">
                        <button type="button" class="desafio-opcion" onclick="responderDesafio(this, 'A')" data-opcion="A">
                            <span>A) <%= desafio.opcion_a %></span>
                        </button>
                        <button type="button" class="desafio-opcion" onclick="responderDesafio(this, 'B')" data-opcion="B">
                            <span>B) <%= desafio.opcion_b %></span>
                        </button>
                        <button type="button" class="desafio-opcion" onclick="responderDesafio(this, 'C')" data-opcion="C">
                            <span>C) <%= desafio.opcion_c %></span>
                        </button>
                    </div>
                    <div id="desafio-feedback" class="fx-reto__feedback" role="status" style="display: none;"></div>
                </div>

                <% if (!usuario) { %>
                    <p class="fx-reto__login"><a href="/auth/login">Iniciá sesión</a> para sumar XP, armar tu racha y entrar al ranking semanal.</p>
                <% } %>
            </section>
            <% } else { %>
            <section class="fx-reto__card" style="text-align: center;">
                <h2>Hoy no hay desafío cargado</h2>
                <p class="fx-page__lead" style="margin: 0.6rem auto 1.4rem;">Volvé más tarde. Mientras tanto, probá el test de nivel.</p>
                <a href="/test-nivel" class="fx-btn fx-btn--sm">Hacer el test de nivel</a>
            </section>
            <% } %>
        </div>

        <% if (usuario) { %>
        <aside class="fx-reto__side">
            <!-- Panel de racha -->
            <section id="panel-racha" class="fx-reto__panel fx-reto__racha">
                <img id="rango-logo" src="/logosracha/sinrango.jpg" alt="Sin rango">
                <div>
                    <div id="rango-nombre" class="fx-reto__rango">Sin rango</div>
                    <div class="fx-reto__stats">
                        <span><strong id="racha-val">0</strong> días de racha</span>
                        <span><strong id="xp-val">0</strong> XP</span>
                    </div>
                </div>
            </section>

            <!-- Ranking semanal -->
            <section class="fx-reto__panel">
                <h3>Ranking de la semana</h3>
                <% if (usuario.ranking && usuario.ranking.length) { %>
                    <ol class="fx-reto__rank">
                        <% usuario.ranking.forEach(r => { %>
                            <li class="<%= r.esYo ? 'is-yo' : '' %>">
                                <span><%= r.nombre %><% if (r.esYo) { %> <em>(vos)</em><% } %></span>
                                <strong><%= r.puntos %> XP</strong>
                            </li>
                        <% }) %>
                    </ol>
                <% } else { %>
                    <p>Todavía nadie sumó puntos esta semana. ¡Sé el primero!</p>
                <% } %>
            </section>

            <!-- Recompensas personalizadas del profesor -->
            <section class="fx-reto__panel">
                <h3>Recompensas del profesor</h3>
                <% if (usuario.recompensas && usuario.recompensas.length) { %>
                    <% usuario.recompensas.forEach(r => { %>
                        <div class="fx-reto__premio">
                            <p><%= r.texto %></p>
                            <small><%= new Date(r.creado_en).toLocaleDateString('es-AR') %></small>
                        </div>
                    <% }) %>
                <% } else { %>
                    <p>Cuando alcances rachas importantes, el profesor te puede mandar una recompensa.</p>
                <% } %>
            </section>
        </aside>

        <!-- Aviso flotante de XP al completar -->
        <div id="toast-xp" class="fx-reto__toast" role="status" style="display: none;"></div>
        <% } %>
    </div>
</main>

<%- include('partials/footer') %>
<script>
    const desafioActual = <%- JSON.stringify(desafio) %>;
    const usuarioSesion = <%- JSON.stringify(usuario) %>;

    const HITOS_RACHA_UI = [
        { minimo: 3, emoji: '🥉', nombre: 'Beginner', logo: '/logosracha/beginner.png' },
        { minimo: 7, emoji: '🥈', nombre: 'Consistent', logo: '/logosracha/consistent.png' },
        { minimo: 30, emoji: '🥇', nombre: 'English Streak', logo: '/logosracha/englishstreak.png' },
        { minimo: 100, emoji: '💎', nombre: 'English Master', logo: '/logosracha/englishmaster.png' }
    ];

    let estadoUsuario = usuarioSesion
        ? { racha: usuarioSesion.racha || 0, xpTotal: usuarioSesion.xpTotal || 0, hito: usuarioSesion.hito || null }
        : null;

    function renderPanelDatos() {
        if (!estadoUsuario) return;
        const racha = estadoUsuario.racha;
        document.getElementById('racha-val').textContent = racha;
        document.getElementById('xp-val').textContent = estadoUsuario.xpTotal;

        const img = document.getElementById('rango-logo');
        const nomEl = document.getElementById('rango-nombre');
        if (!img || !nomEl) return;
        const actual = estadoUsuario.hito
            ? HITOS_RACHA_UI.find(h => h.minimo === estadoUsuario.hito.minimo)
            : null;
        if (actual) {
            img.src = actual.logo;
            img.alt = actual.nombre;
            nomEl.textContent = actual.nombre;
        } else {
            img.src = '/logosracha/sinrango.jpg';
            img.alt = 'Sin rango';
            nomEl.textContent = 'Sin rango';
        }
    }

    function mostrarToastAviso(mensaje) {
        const t = document.getElementById('toast-xp');
        if (!t) return;
        t.textContent = mensaje;
        t.style.display = 'block';
        clearTimeout(window.__toastTimer);
        window.__toastTimer = setTimeout(() => { t.style.display = 'none'; }, 3200);
    }

    async function registrarCompletado() {
        if (!estadoUsuario) return;
        try {
            const res = await fetch('/desafio-diario/completar', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            });
            const data = await res.json();
            if (data.success) {
                estadoUsuario.racha = data.racha;
                estadoUsuario.xpTotal = data.xpTotal;
                estadoUsuario.hito = data.hito;
                renderPanelDatos();
                if (data.xp > 0) mostrarToastAviso('¡Desafío completado! +10 XP');
                if (data.desbloqueo) {
                    setTimeout(() => mostrarToastAviso('🎁 ¡Desbloqueaste ' + data.desbloqueo.nombre + '! ' + data.desbloqueo.emoji), 3500);
                }
            }
        } catch (e) { console.error('Error al registrar el desafío:', e); }
    }

    let audioEscuchado = false;

    function esDesafioAudio() {
        return !!(desafioActual && (desafioActual.tipo === 'listening' || desafioActual.tipo === 'listening_corto'));
    }

    function reproducirAudio() {
        if (!('speechSynthesis' in window)) { return; }
        const texto = (desafioActual && (desafioActual.texto_audio || desafioActual.pregunta)) || '';
        if (!texto) { return; }

        // Cargar voces de forma asíncrona por si aún no están disponibles.
        if (window.speechSynthesis.getVoices().length === 0) {
            window.speechSynthesis.onvoiceschanged = () => window.speechSynthesis.getVoices();
        }
        const voces = window.speechSynthesis.getVoices();
        const utt = new SpeechSynthesisUtterance(texto);
        utt.lang = 'en-US';
        const voz = voces.find(v => v.lang && v.lang.includes('en-US'));
        if (voz) utt.voice = voz;
        utt.rate = 0.9;

        window.speechSynthesis.cancel();
        window.speechSynthesis.speak(utt);

        audioEscuchado = true;
        const btn = document.getElementById('btn-escuchar');
        if (btn) btn.textContent = 'Escuchar de nuevo';
        const ayuda = document.getElementById('escuchar-ayuda');
        if (ayuda) ayuda.style.display = 'none';
        habilitarOpciones();
    }

    function habilitarOpciones() {
        document.querySelectorAll('.desafio-opcion').forEach(op => { op.disabled = false; });
    }

    function responderDesafio(boton, opcion) {
        const opciones = document.querySelectorAll('.desafio-opcion');
        const feedback = document.getElementById('desafio-feedback');
        const correcta = desafioActual.respuesta_correcta;

        opciones.forEach(op => op.disabled = true);

        if (opcion === correcta) {
            boton.classList.add('correcta');
            feedback.style.display = 'block';
            feedback.className = 'fx-reto__feedback is-ok';
            feedback.innerHTML = `
                <strong>¡Correcto! 🎉</strong>
                <p>${document.querySelector('.desafio-opcion[data-opcion="' + correcta + '"]').textContent}</p>
                <p><strong>Explicación:</strong> ${desafioActual.explicacion}</p>
                <p><strong>Ejemplo:</strong> ${desafioActual.ejemplo}</p>
            `;

            const hoy = new Date().toDateString();
            localStorage.setItem('desafio_completado_' + hoy, String(desafioActual.numero));

            document.querySelector('#desafio-del-dia h2').innerHTML = `Resolvé el desafío de hoy ✅`;

            registrarCompletado();
        } else {
            boton.classList.add('incorrecta');
            feedback.style.display = 'block';
            feedback.className = 'fx-reto__feedback is-error';
            feedback.innerHTML = `
                <strong>Incorrecto ❌</strong>
                <p>La respuesta correcta era: <strong>${correcta})</strong></p>
                <p><strong>Explicación:</strong> ${desafioActual.explicacion}</p>
                <p><strong>Ejemplo:</strong> ${desafioActual.ejemplo}</p>
            `;
        }
    }

    function marcarComoCompletado() {
        const opciones = document.querySelectorAll('.desafio-opcion');
        opciones.forEach(op => {
            op.disabled = true;
            if (op.getAttribute('data-opcion') === desafioActual.respuesta_correcta) {
                op.classList.add('correcta');
            }
        });

        document.querySelector('#desafio-del-dia h2').innerHTML = `Resolvé el desafío de hoy ✅`;

        const feedback = document.getElementById('desafio-feedback');
        feedback.style.display = 'block';
        feedback.className = 'fx-reto__feedback is-ok';
        feedback.innerHTML = '<strong>¡Ya completaste este desafío hoy! 🎉</strong><p>Volvé mañana para uno nuevo.</p>';
    }

    // Al cargar: render del panel de racha/hitos y verificar si ya completó hoy
    renderPanelDatos();
    if (desafioActual) {
        // Para tipos de listening, las opciones quedan bloqueadas hasta que se reproduzca el audio.
        if (esDesafioAudio()) {
            document.querySelectorAll('.desafio-opcion').forEach(op => { op.disabled = true; });
        }
        const hoy = new Date().toDateString();
        const completadoHoy = localStorage.getItem('desafio_completado_' + hoy);
        if (completadoHoy === desafioActual.numero.toString() || (usuarioSesion && usuarioSesion.completadoHoy)) {
            marcarComoCompletado();
        }
    }
</script>

</body>
</html>