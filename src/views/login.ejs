<!DOCTYPE html>
<html lang="es">
<head>
    <link rel="icon" type="image/svg+xml" href="/img/favicon-suez.svg">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Iniciar sesión · Inglés Suez</title>
</head>
<body class="tema-flyer">
    <%- include('partials/header') %>

    <main class="fx-auth">
        <div class="fx-auth__card">
            <%- include('partials/auth-star') %>
            <span class="fx-auth__eyebrow">Bienvenido de nuevo</span>
            <h1 class="fx-auth__title">Iniciá <span class="fx-steel">sesión</span></h1>
            <p class="fx-auth__lead">Entrá para seguir con tus cursos, tus entregas y tus mensajes.</p>

            <% if (locals.error) { %>
                <p class="fx-alert is-error" role="alert"><%= error %></p>
            <% } %>
            <% if (locals.success) { %>
                <p class="fx-alert is-ok" role="status"><%= success %></p>
            <% } %>

            <form action="/auth/login" method="POST">
                <div class="fx-field">
                    <label for="email">Email</label>
                    <input class="fx-input" type="email" id="email" name="email" placeholder="tu@email.com" autocomplete="email" required autofocus>
                </div>
                <div class="fx-field">
                    <label for="password">Contraseña</label>
                    <div class="fx-pass">
                        <input class="fx-input" type="password" id="password" name="password" autocomplete="current-password" required>
                        <button type="button" aria-pressed="false">Mostrar</button>
                    </div>
                </div>
                <div class="fx-auth__row"><a href="/auth/forgot-password">¿Olvidaste tu contraseña?</a></div>
                <button type="submit" class="fx-btn fx-btn--solid">Entrar</button>
            </form>

            <p class="fx-auth__foot">¿Todavía no tenés cuenta? <a href="/auth/register">Registrate</a></p>
        </div>
    </main>

    <%- include('partials/footer') %>
    <%- include('partials/auth-pass') %>
</body>
</html>
