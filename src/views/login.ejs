<%- include('partials/header') %>

<main style="max-width: 460px; margin: 60px auto; padding: 32px; background: #ffffff; border-radius: 12px; box-shadow: 0 4px 20px rgba(0,0,0,0.08); font-family: 'GFS Didot', serif;">
    <h2 style="margin-bottom: 8px; color: #0f2537; text-align: center; font-size: 1.8rem; font-weight: 400; font-family: 'Tenor Sans', sans-serif; letter-spacing: 0.5px;">Iniciar Sesión</h2>
    <p style="margin-bottom: 24px; color: #666; text-align: center; font-size: 1rem; font-family: 'GFS Didot', serif;">Ingresa a tu cuenta de ingles.suez</p>

    <form action="/auth/login" method="POST" style="display: flex; flex-direction: column; gap: 18px;">
        <div style="display: flex; flex-direction: column; gap: 6px;">
            <label style="font-size: 0.95rem; color: #333; font-family: 'GFS Didot', serif;">Correo Electrónico</label>
            <input type="email" name="email" placeholder="tu@email.com" required style="padding: 11px 14px; border: 1px solid #ccc; border-radius: 8px; font-size: 0.95rem; outline: none; font-family: 'GFS Didot', serif;">
        </div>

        <div style="display: flex; flex-direction: column; gap: 6px;">
            <label style="font-size: 0.95rem; color: #333; font-family: 'GFS Didot', serif;">Contraseña</label>
            <input type="password" name="password" placeholder="Tu contraseña" required style="padding: 11px 14px; border: 1px solid #ccc; border-radius: 8px; font-size: 0.95rem; outline: none; font-family: 'GFS Didot', serif;">
        </div>

        <button type="submit" style="margin-top: 8px; padding: 12px; background: #0f2537; color: #ffffff; border: none; border-radius: 8px; font-size: 1.05rem; cursor: pointer; transition: background 0.2s; font-family: 'Tenor Sans', sans-serif; letter-spacing: 0.5px;">
            Ingresar
        </button>
    </form>

    <p style="margin-top: 24px; text-align: center; font-size: 0.95rem; color: #666; font-family: 'GFS Didot', serif;">
        ¿No tienes cuenta? <a href="/register" style="color: #0f2537; font-weight: bold; text-decoration: underline; font-family: 'Tenor Sans', sans-serif;">Regístrate aquí</a>
    </p>
</main>

<%- include('partials/footer') %>