<!DOCTYPE html>
<html lang="es">
<head>
    <link rel="icon" type="image/svg+xml" href="/img/favicon-suez.svg">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Clases particulares · Panel del profesor</title>
</head>
<body class="tema-flyer">

    <%- include('partials/header') %>

    <%
        const lista = Array.isArray(consultas) ? consultas : [];

        // Mismo criterio que la vista del alumno: no duplicar el primer mensaje
        const hiloDe = (c) => {
            const chat = Array.isArray(c.mensajesChat) ? c.mensajesChat : [];
            const msgs = [];
            if (!(chat.length && chat[0].emisor === 'ALUMNO' && chat[0].mensaje === c.mensaje_alumno)) {
                msgs.push({ emisor: 'ALUMNO', mensaje: c.mensaje_alumno, fecha: c.fecha_consulta });
            }
            chat.forEach(m => msgs.push(m));
            if (!chat.length && c.respuesta_profesor) {
                msgs.push({ emisor: 'PROFESOR', mensaje: c.respuesta_profesor, fecha: c.fecha_respuesta || c.fecha_consulta });
            }
            return msgs;
        };
        const hilos = lista.map(c => {
            const h = hiloDe(c);
            const ult = h[h.length - 1] || {};
            return { c, h, ult, pendiente: ult.emisor !== 'PROFESOR' };
        });
        // Primero las que esperan respuesta, después por fecha del último mensaje
        hilos.sort((a, b) => (b.pendiente - a.pendiente) || (new Date(b.ult.fecha || 0) - new Date(a.ult.fecha || 0)));
        const pendientes = hilos.filter(x => x.pendiente).length;

        const dia = (f) => f ? new Date(f).toLocaleDateString('es-AR', { day: 'numeric', month: 'long' }) : '';
        const diaCorto = (f) => f ? new Date(f).toLocaleDateString('es-AR', { day: '2-digit', month: '2-digit' }) : '';
        const hora = (f) => f ? new Date(f).toLocaleTimeString('es-AR', { hour: '2-digit', minute: '2-digit' }) : '';
        const inicial = (n) => (n || '?').trim().charAt(0).toUpperCase();
    %>

    <main class="fx-page">
        <nav class="fx-tabs" aria-label="Secciones del profesor">
            <a href="/profesor/entregas">Entregas de cursos</a>
            <a href="/profesor/gestion">Gestión de cursos</a>
            <a href="/profesor/consultas">Consultas de alumnos</a>
            <a href="/profesor/particulares" aria-current="page">Clases particulares</a>
        </nav>

        <div class="fx-block__head" style="margin: 2.2rem 0 0;">
            <h1 class="fx-page__title">Clases <span class="fx-steel">particulares</span></h1>
            <p><%= pendientes === 0 ? 'Estás al día: no hay consultas esperando respuesta.' : (pendientes === 1 ? 'Hay 1 consulta esperando tu respuesta.' : 'Hay ' + pendientes + ' consultas esperando tu respuesta.') %></p>
        </div>

        <% if (hilos.length === 0) { %>
            <div class="fx-panel" style="margin-top: 2rem; text-align: center; padding: 3rem 1.5rem;">
                <h2>Todavía no llegaron consultas</h2>
                <p style="margin: 0;">Cuando un alumno pida una clase desde la página de particulares, la vas a ver acá.</p>
            </div>
        <% } else { %>
        <div class="fx-chat" id="fx-chat">
            <aside class="fx-chat__side">
                <div class="fx-chat__side-head" style="flex-wrap: wrap;">
                    <div class="fx-seg" role="group" aria-label="Filtrar consultas">
                        <button type="button" data-filtro="pendientes" aria-pressed="<%= pendientes > 0 ? 'true' : 'false' %>">Sin responder <span class="fx-badge-count"><%= pendientes %></span></button>
                        <button type="button" data-filtro="todas" aria-pressed="<%= pendientes > 0 ? 'false' : 'true' %>">Todas</button>
                    </div>
                    <input type="search" class="fx-input" id="fx-buscar" placeholder="Buscar alumno" aria-label="Buscar alumno" style="padding: 0.55rem 0.9rem; border-radius: 999px;">
                </div>
                <ul class="fx-chat__list" role="tablist" aria-label="Consultas">
                    <% hilos.forEach(({ c, ult, pendiente }) => { %>
                        <li data-pendiente="<%= pendiente ? '1' : '0' %>" data-nombre="<%= ((c.usuario_nombre || '') + ' ' + (c.usuario_email || '')).toLowerCase() %>">
                            <button type="button" class="fx-chat__item fx-chat__item--avatar" role="tab" data-consulta="<%= c.id %>" aria-selected="false">
                                <span class="fx-avatar" aria-hidden="true"><%= inicial(c.usuario_nombre) %></span>
                                <span style="min-width: 0;">
                                    <span class="fx-chat__item-top">
                                        <span class="fx-chat__item-name"><%= c.usuario_nombre %></span>
                                        <span class="fx-chat__item-date"><%= diaCorto(ult.fecha || c.fecha_consulta) %></span>
                                    </span>
                                    <span class="fx-chat__item-prev" style="display: block;">
                                        <% if (pendiente) { %><span class="fx-chat__dot" title="Esperando respuesta"></span><% } %><%= ult.emisor === 'PROFESOR' ? 'Vos: ' : '' %><%= ult.mensaje %>
                                    </span>
                                </span>
                            </button>
                        </li>
                    <% }) %>
                </ul>
                <p class="fx-chat__empty-list" id="fx-lista-vacia" hidden>No hay consultas con ese filtro.</p>
            </aside>

            <div class="fx-chat__main">
                <div class="fx-chat__blank" id="fx-blank">Elegí una consulta para ver la conversación.</div>
                <% hilos.forEach(({ c, h }) => { let ultimoDia = ''; %>
                    <div class="fx-chat__conv" data-consulta="<%= c.id %>" role="tabpanel" style="display: none; flex-direction: column; flex: 1; min-height: 0;">
                        <div class="fx-chat__head">
                            <button type="button" class="fx-chat__back" aria-label="Volver a la lista">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 6l-6 6 6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                            </button>
                            <span class="fx-avatar" aria-hidden="true"><%= inicial(c.usuario_nombre) %></span>
                            <span style="min-width: 0;">
                                <span class="fx-chat__head-title" style="display: block;"><%= c.usuario_nombre %></span>
                                <a href="mailto:<%= c.usuario_email %>" class="fx-chat__head-meta" style="text-decoration: none;"><%= c.usuario_email %></a>
                            </span>
                            <span style="margin-left: auto; display: flex; gap: 0.4rem; flex-wrap: wrap;">
                                <span class="fx-tag"><%= c.modalidad %></span>
                                <span class="fx-tag"><%= c.objetivo %></span>
                            </span>
                        </div>

                        <div class="fx-thread" aria-live="polite">
                            <% h.forEach(m => { const d = dia(m.fecha); %>
                                <% if (d && d !== ultimoDia) { ultimoDia = d; %>
                                    <div class="fx-thread__day"><%= d %></div>
                                <% } %>
                                <div class="fx-msg <%= m.emisor === 'PROFESOR' ? 'fx-msg--me' : 'fx-msg--them' %>">
                                    <div class="fx-msg__bubble"><%= m.mensaje %></div>
                                    <span class="fx-msg__time"><%= m.emisor === 'PROFESOR' ? 'Vos' : c.usuario_nombre %><%= hora(m.fecha) ? ', ' + hora(m.fecha) : '' %></span>
                                </div>
                            <% }) %>
                        </div>

                        <form class="fx-composer" data-consulta="<%= c.id %>">
                            <label for="r-<%= c.id %>" style="position: absolute; left: -9999px;">Respuesta</label>
                            <textarea id="r-<%= c.id %>" rows="1" placeholder="Responder a <%= c.usuario_nombre %>" required></textarea>
                            <button type="submit" class="fx-send" aria-label="Enviar respuesta">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h13M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                            </button>
                        </form>
                        <p class="fx-composer__hint">Enter para enviar, Shift + Enter para un salto de línea</p>
                    </div>
                <% }) %>
            </div>
        </div>
        <% } %>
    </main>

    <%- include('partials/footer') %>

    <script>
    (function () {
        var chat = document.getElementById('fx-chat');
        if (!chat) return;
        var items = Array.prototype.slice.call(chat.querySelectorAll('.fx-chat__list li'));
        var buscar = document.getElementById('fx-buscar');
        var filtro = chat.querySelector('[data-filtro][aria-pressed="true"]').dataset.filtro;

        function abajo(conv) { var t = conv.querySelector('.fx-thread'); if (t) t.scrollTop = t.scrollHeight; }
        function abrir(id, enMovil, foco) {
            if (enMovil) chat.classList.add('is-thread');
            document.getElementById('fx-blank').style.display = 'none';
            chat.querySelectorAll('.fx-chat__item').forEach(function (b) { b.setAttribute('aria-selected', b.dataset.consulta === id ? 'true' : 'false'); });
            chat.querySelectorAll('.fx-chat__conv').forEach(function (c) {
                var on = c.dataset.consulta === id;
                c.style.display = on ? 'flex' : 'none';
                if (on) { abajo(c); if (foco && !enMovil) c.querySelector("textarea").focus({ preventScroll: true }); }
            });
        }
        function aplicarFiltro() {
            var q = (buscar.value || '').trim().toLowerCase();
            var visibles = 0;
            items.forEach(function (li) {
                var ok = (filtro === 'todas' || li.dataset.pendiente === '1') && (!q || li.dataset.nombre.indexOf(q) !== -1);
                li.hidden = !ok;
                if (ok) visibles++;
            });
            document.getElementById('fx-lista-vacia').hidden = visibles > 0;
        }
        chat.querySelectorAll('[data-filtro]').forEach(function (b) {
            b.addEventListener('click', function () {
                filtro = b.dataset.filtro;
                chat.querySelectorAll('[data-filtro]').forEach(function (o) { o.setAttribute('aria-pressed', o === b ? 'true' : 'false'); });
                aplicarFiltro();
            });
        });
        buscar.addEventListener('input', aplicarFiltro);
        chat.querySelectorAll('.fx-chat__item').forEach(function (b) {
            b.addEventListener('click', function () { abrir(b.dataset.consulta, window.matchMedia("(max-width: 860px)").matches, true); });
        });
        chat.querySelectorAll('.fx-chat__back').forEach(function (b) {
            b.addEventListener('click', function () { chat.classList.remove('is-thread'); });
        });
        aplicarFiltro();
        // En escritorio, abrir directo la primera consulta visible
        if (!window.matchMedia('(max-width: 860px)').matches) {
            var primera = items.find(function (li) { return !li.hidden; });
            if (primera) abrir(primera.querySelector('.fx-chat__item').dataset.consulta, false);
        }

        chat.querySelectorAll('.fx-composer').forEach(function (f) {
            var ta = f.querySelector('textarea');
            var btn = f.querySelector('button');
            ta.addEventListener('input', function () { ta.style.height = 'auto'; ta.style.height = Math.min(ta.scrollHeight, 160) + 'px'; });
            ta.addEventListener('keydown', function (e) {
                if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); f.requestSubmit(); }
            });
            f.addEventListener('submit', async function (e) {
                e.preventDefault();
                var texto = ta.value.trim();
                if (!texto) return;
                var id = f.dataset.consulta;
                var hilo = f.closest('.fx-chat__conv').querySelector('.fx-thread');
                var msg = document.createElement('div');
                msg.className = 'fx-msg fx-msg--me fx-msg--pending';
                msg.innerHTML = '<div class="fx-msg__bubble"></div><span class="fx-msg__time">Enviando…</span>';
                msg.firstChild.textContent = texto;
                hilo.appendChild(msg);
                hilo.scrollTop = hilo.scrollHeight;
                ta.value = ''; ta.style.height = '';
                btn.disabled = true;
                try {
                    var res = await fetch('/profesor/particulares/responder', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ consultaId: id, respuesta: texto })
                    });
                    var data = await res.json();
                    if (!data.success) throw new Error(data.message);
                    msg.classList.remove('fx-msg--pending');
                    msg.lastChild.textContent = 'Vos, ' + new Date().toLocaleTimeString('es-AR', { hour: '2-digit', minute: '2-digit' });
                    // La consulta deja de estar pendiente
                    var li = chat.querySelector('.fx-chat__item[data-consulta="' + id + '"]').closest('li');
                    li.dataset.pendiente = '0';
                    li.querySelector('.fx-chat__item-prev').textContent = 'Vos: ' + texto;
                    var badge = chat.querySelector('[data-filtro="pendientes"] .fx-badge-count');
                    badge.textContent = items.filter(function (x) { return x.dataset.pendiente === '1'; }).length;
                } catch (err) {
                    msg.classList.remove('fx-msg--pending');
                    msg.classList.add('fx-msg--failed');
                    msg.lastChild.textContent = 'No se envió. Tocá para reintentar.';
                    msg.style.cursor = 'pointer';
                    msg.addEventListener('click', function () { ta.value = texto; msg.remove(); ta.focus(); }, { once: true });
                } finally {
                    btn.disabled = false;
                }
            });
        });
    })();
    </script>
</body>
</html>
