<!DOCTYPE html>
<html lang="es">
<head>
    <link rel="icon" type="image/svg+xml" href="/img/favicon-suez.svg">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Recuperar contraseña · Inglés Suez</title>
</head>
<body class="tema-flyer">
    <%- include('partials/header') %>

    <main class="fx-auth">
        <div class="fx-auth__card">
            <%- include('partials/auth-star') %>
            <span class="fx-auth__eyebrow">Tu cuenta</span>
            <h1 class="fx-auth__title">Recuperá tu <span class="fx-steel">contraseña</span></h1>

            <% if (success) { %>
                <p class="fx-alert is-ok" role="status"><%= success %></p>
                <p class="fx-auth__lead">Revisá también la carpeta de spam.</p>
                <a href="/auth/login" class="fx-btn fx-btn--solid" style="width: 100%; justify-content: center;">Volver a iniciar sesión</a>
            <% } else { %>
                <p class="fx-auth__lead">Escribí el email con el que te registraste y te mandamos un enlace para crear una contraseña nueva.</p>

                <% if (error) { %>
                    <p class="fx-alert is-error" role="alert"><%= error %></p>
                <% } %>

                <form action="/auth/forgot-password" method="POST">
                    <div class="fx-field">
                        <label for="email">Email</label>
                        <input class="fx-input" type="email" id="email" name="email" placeholder="tu@email.com" autocomplete="email" required autofocus>
                    </div>
                    <button type="submit" class="fx-btn fx-btn--solid">Enviarme el enlace</button>
                </form>
            <% } %>

            <p class="fx-auth__foot">¿Te acordaste? <a href="/auth/login">Iniciá sesión</a></p>
        </div>
    </main>

    <%- include('partials/footer') %>
</body>
</html>
