<!-- Tipografía del flyer -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,400;1,500;1,800;1,900&display=swap" rel="stylesheet">

<!-- Vincular CSS global -->
<link rel="stylesheet" href="/css/styles.css?v=2.0">

<header class="fx-nav<%= locals.user ? ' fx-nav--user' : '' %>">
    <div class="fx-nav__inner">
        <div style="display: flex; align-items: center; gap: 2.5rem;">
            <%- include('logo') %>

            <nav class="fx-nav__links" aria-label="Secciones">
                <a href="/cursos-todos">Cursos</a>
                <a href="/test-nivel">Test de nivel</a>
                <a href="/desafio-diario">Desafío del día</a>
                <a href="/about">Acerca de</a>
            </nav>
        </div>

        <div class="fx-nav__end">
        <div class="fx-nav__right">
            <% if (locals.user) { %>

                <% if (locals.user.email === 'suezsantiago1@gmail.com') { %>
                    <a href="/profesor/entregas" class="fx-chip-teacher">Panel profesor</a>
                    <a href="/profesor/rachas" class="fx-chip-teacher">Rachas</a>
                <% } %>

                <div class="fx-nav__msgs">
                    <div>
                        <a href="/messages">Mis mensajes</a>
                        <% if (locals.mensajesNoLeidos && locals.mensajesNoLeidos > 0) { %>
                            <span class="fx-badge-count"><%= locals.mensajesNoLeidos %></span>
                        <% } %>
                        <span id="mensajesMenuBtn" title="Opciones" role="button" tabindex="0" aria-label="Opciones de mensajes">
                            <svg style="width:0.7rem; height:0.7rem;" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 9l6 6 6-6" /></svg>
                        </span>
                    </div>
                    <div id="mensajesMenuDesplegable" class="fx-dropdown">
                        <a href="/messages">Ver mensajes</a>
                        <button type="button" onclick="marcarMensajesLeidos()" id="btnMarcarLeidosMenu">Marcar como leídos</button>
                    </div>
                </div>

                <a href="/mis-cursos">Mis cursos</a>
                <a href="/auth/profile">Mi perfil</a>
                <a href="/auth/logout" class="fx-logout">Cerrar sesión</a>
            <% } else { %>
                <a href="/auth/login">Iniciar sesión</a>
                <a href="/auth/register" class="fx-btn fx-btn--sm">Registrarse</a>
            <% } %>
        </div>

        <a href="/clases-particulares" class="fx-btn fx-btn--sm fx-btn--solid">Clases particulares</a>

        <button class="fx-menu-btn" onclick="toggleMobileMenu()" aria-label="Abrir menú">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6">
                <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h10" />
            </svg>
        </button>
        </div>
    </div>
</header>

<!-- Menú móvil -->
<div class="fx-mobile-overlay" onclick="toggleMobileMenu()"></div>
<aside class="fx-mobile" aria-label="Menú">
    <div class="fx-mobile__head">
        <%- include('logo') %>
        <button onclick="toggleMobileMenu()" class="fx-menu-btn" style="display: block;" aria-label="Cerrar menú">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6">
                <path stroke-linecap="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
        </button>
    </div>

    <nav>
        <a href="/" onclick="toggleMobileMenu()">Inicio</a>
        <a href="/cursos-todos" onclick="toggleMobileMenu()">Cursos</a>
        <a href="/clases-particulares" onclick="toggleMobileMenu()">Clases particulares</a>
        <a href="/test-nivel" onclick="toggleMobileMenu()">Test de nivel</a>
        <a href="/desafio-diario" onclick="toggleMobileMenu()">Desafío del día</a>
        <a href="/about" onclick="toggleMobileMenu()">Acerca de</a>

        <div class="fx-sep"></div>

        <% if (locals.user) { %>
            <% if (locals.user.email === 'suezsantiago1@gmail.com') { %>
                <a href="/profesor/entregas" onclick="toggleMobileMenu()" class="fx-chip-teacher">Panel profesor</a>
                <a href="/profesor/rachas" onclick="toggleMobileMenu()" class="fx-chip-teacher">Rachas</a>
            <% } %>

            <a href="/messages" onclick="toggleMobileMenu()">
                <span>Mis mensajes</span>
                <% if (locals.mensajesNoLeidos && locals.mensajesNoLeidos > 0) { %>
                    <span class="fx-badge-count"><%= locals.mensajesNoLeidos %></span>
                <% } %>
            </a>
            <% if (locals.mensajesNoLeidos && locals.mensajesNoLeidos > 0) { %>
                <a href="#" onclick="event.preventDefault(); marcarMensajesLeidos(); toggleMobileMenu();" id="btnMarcarLeidosMenuMobile" style="color: var(--fx-muted); font-size: 0.95rem;">Marcar mensajes como leídos</a>
            <% } %>
            <a href="/mis-cursos" onclick="toggleMobileMenu()">Mis cursos</a>
            <a href="/auth/profile" onclick="toggleMobileMenu()">Mi perfil</a>
            <a href="/auth/logout" onclick="toggleMobileMenu()" class="fx-logout">Cerrar sesión</a>
        <% } else { %>
            <a href="/auth/login" onclick="toggleMobileMenu()">Iniciar sesión</a>
            <a href="/auth/register" onclick="toggleMobileMenu()" class="fx-btn">Registrarse</a>
        <% } %>
    </nav>
</aside>

<script>
function toggleMobileMenu() {
    const menu = document.querySelector('.fx-mobile');
    const overlay = document.querySelector('.fx-mobile-overlay');
    const abierto = menu.classList.toggle('active');
    overlay.classList.toggle('active', abierto);
    document.body.style.overflow = abierto ? 'hidden' : '';
}

// Menú desplegable de Mis Mensajes: se abre con la flechita (click o teclado)
function toggleMensajesMenu() {
    const menu = document.getElementById('mensajesMenuDesplegable');
    if (!menu) return;
    menu.style.display = menu.style.display === 'block' ? 'none' : 'block';
}

document.addEventListener('click', function (e) {
    const btn = document.getElementById('mensajesMenuBtn');
    const menu = document.getElementById('mensajesMenuDesplegable');
    if (!btn || !menu) return;
    if (btn.contains(e.target)) {
        toggleMensajesMenu();
    } else if (!menu.contains(e.target)) {
        menu.style.display = 'none';
    }
});

document.addEventListener('keydown', function (e) {
    const btn = document.getElementById('mensajesMenuBtn');
    if (btn && document.activeElement === btn && (e.key === 'Enter' || e.key === ' ')) {
        e.preventDefault();
        toggleMensajesMenu();
    }
    if (e.key === 'Escape') {
        const menu = document.getElementById('mensajesMenuDesplegable');
        if (menu) menu.style.display = 'none';
        const mobile = document.querySelector('.fx-mobile');
        if (mobile && mobile.classList.contains('active')) toggleMobileMenu();
    }
});

// Marca todas las devoluciones del alumno como leídas y actualiza la UI
function marcarMensajesLeidos() {
    const menu = document.getElementById('mensajesMenuDesplegable');
    fetch('/messages/leer', { method: 'POST' })
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                if (menu) menu.style.display = 'none';
                alert('Mensajes marcados como leídos.');
                window.location.reload();
            } else {
                alert(data.message || 'No se pudieron marcar como leídos.');
            }
        })
        .catch(() => alert('Error de conexión al marcar como leídos.'));
}
</script>
