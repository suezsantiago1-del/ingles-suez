<!-- Importación de Google Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=GFS+Didot&family=Tenor+Sans&display=swap" rel="stylesheet">

<!-- Vincular CSS global -->
<link rel="stylesheet" href="/css/styles.css?v=1.2">

<style>
  html, body {
    margin: 0 !important;
    padding: 0 !important;
    width: 100%;
    min-height: 100vh;
    box-sizing: border-box;
  }
  * {
    box-sizing: border-box;
  }

  /* Mobile menu styles */
  .mobile-menu-btn {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
  }
  
  .mobile-menu-overlay {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.5);
    z-index: 200;
  }
  
  .mobile-menu {
    display: none;
    position: fixed;
    top: 0;
    right: -300px;
    width: 300px;
    height: 100%;
    background: #0b2238;
    z-index: 201;
    padding: 2rem;
    transition: right 0.3s ease;
    overflow-y: auto;
  }
  
  .mobile-menu.active {
    right: 0;
  }
  
  .mobile-menu-overlay.active {
    display: block;
  }
  
  .mobile-menu a {
    display: block;
    color: white;
    text-decoration: none;
    padding: 1rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    font-family: 'GFS Didot', serif;
  }
  
  .mobile-menu a:hover {
    opacity: 0.8;
  }

  /* Ajustes para pantallas pequeñas (Celulares) */
  @media (max-width: 1024px) {
    .mobile-menu-btn {
      display: block;
    }
    
    .nav-links-left {
      display: none !important;
    }
    
    .nav-links-right {
      display: none !important;
    }
    
    .main-nav {
      padding: 0.8rem 1rem !important;
    }
    
    .nav-left {
      gap: 1rem !important;
    }
    
    .nav-left img {
      height: 50px !important;
    }
  }
  
  @media (min-width: 1025px) {
    .mobile-menu,
    .mobile-menu-overlay {
      display: none !important;
    }
  }
</style>

<nav class="main-nav" style="background: #0b2238; padding: 0.8rem 2.5rem; display: flex; justify-content: space-between; align-items: center; font-family: 'Tenor Sans', sans-serif; position: relative; z-index: 100; border-bottom: 2px solid #184168; margin: 0; width: 100%;">
    <div class="nav-left" style="display: flex; align-items: center; gap: 1.5rem;">
        <a href="/" style="display: flex; align-items: center; text-decoration: none;">
            <img src="/img/logo.jpg" alt="INGLÉS SUEZ" style="height: 68px; width: auto; object-fit: contain; border-radius: 6px;">
        </a>
        
        <!-- Enlaces secundarios (Desktop) -->
        <div class="nav-links-left" style="display: flex; gap: 1.8rem; align-items: center; margin-left: 0.5rem;">
            <a href="/cursos-todos" style="color: white; text-decoration: none; font-size: 1.05rem; opacity: 0.45; font-family: 'GFS Didot', serif; transition: opacity 0.2s ease;" onmouseover="this.style.opacity='1'" onmouseout="this.style.opacity='0.45'">Cursos</a>
            <a href="/clases-particulares" style="color: white; text-decoration: none; font-size: 1.05rem; opacity: 0.45; font-family: 'GFS Didot', serif; transition: opacity 0.2s ease;" onmouseover="this.style.opacity='1'" onmouseout="this.style.opacity='0.45'">Clases Particulares</a>
            <a href="/about" style="color: white; text-decoration: none; font-size: 1.05rem; opacity: 0.45; font-family: 'GFS Didot', serif; transition: opacity 0.2s ease;" onmouseover="this.style.opacity='1'" onmouseout="this.style.opacity='0.45'">Acerca de</a>
        </div>
    </div>
    
    <!-- Mobile menu button -->
    <button class="mobile-menu-btn" onclick="toggleMobileMenu()">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="white">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
    </button>
    
    <!-- Desktop navigation -->
    <div class="nav-links-right" style="display: flex; gap: 1.8rem; align-items: center;">
        <a href="/" style="color: white; text-decoration: none; font-size: 1rem; font-family: 'GFS Didot', serif;">Inicio</a>
        
        <% if (locals.user) { %>
            <% if (locals.user.email === 'suezsantiago1@gmail.com') { %>
                <!-- Botón exclusivo para el Profesor -->
                <a href="/profesor/entregas" style="background: #e2ebd5; color: #0b2238; padding: 0.4rem 0.9rem; border-radius: 6px; text-decoration: none; font-weight: bold; font-size: 0.95rem; font-family: 'Tenor Sans', sans-serif;">Panel Profesor</a>
            <% } %>

            <!-- Enlace a Bandeja de Mensajes para Alumnos -->
            <a href="/messages" style="color: white; text-decoration: none; font-size: 1rem; font-family: 'GFS Didot', serif; position: relative;">
                Mis Mensajes
                <% if (locals.mensajesNoLeidos && locals.mensajesNoLeidos > 0) { %>
                    <span style="background: #e53e3e; color: white; border-radius: 50%; padding: 0.1rem 0.4rem; font-size: 0.75rem; font-weight: bold; margin-left: 0.3rem;"><%= locals.mensajesNoLeidos %></span>
                <% } %>
            </a>

            <a href="/mis-cursos" style="color: white; text-decoration: none; font-size: 1rem; font-family: 'GFS Didot', serif;">Mis Cursos</a>
            <a href="/auth/profile" style="color: white; text-decoration: none; font-size: 1rem; font-family: 'GFS Didot', serif;">Mi Perfil</a>
            <a href="/auth/logout" style="color: #feb2b2; text-decoration: none; font-weight: bold; font-size: 1rem; font-family: 'GFS Didot', serif;">Cerrar Sesión</a>
        <% } else { %>
            <a href="/auth/login" style="color: white; text-decoration: none; font-size: 1rem; font-family: 'GFS Didot', serif;">Iniciar Sesión</a>
            <a href="/auth/register" style="background: white; color: #0b2238; padding: 0.6rem 1.3rem; border-radius: 6px; text-decoration: none; font-weight: bold; font-size: 0.95rem; font-family: 'Tenor Sans', sans-serif;">Registrarse</a>
        <% } %>
    </div>
</nav>

<!-- Mobile menu -->
<div class="mobile-menu-overlay" onclick="toggleMobileMenu()"></div>
<div class="mobile-menu">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
        <span style="color: white; font-weight: bold; font-family: 'Tenor Sans', sans-serif;">Menú</span>
        <button onclick="toggleMobileMenu()" style="background: none; border: none; cursor: pointer;">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="white">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
        </button>
    </div>
    
    <a href="/" onclick="toggleMobileMenu()">Inicio</a>
    <a href="/cursos-todos" onclick="toggleMobileMenu()">Cursos</a>
    <a href="/clases-particulares" onclick="toggleMobileMenu()">Clases Particulares</a>
    <a href="/about" onclick="toggleMobileMenu()">Acerca de</a>
    
    <% if (locals.user) { %>
        <% if (locals.user.email === 'suezsantiago1@gmail.com') { %>
            <a href="/profesor/entregas" onclick="toggleMobileMenu()" style="background: #e2ebd5; color: #0b2238; padding: 0.5rem; border-radius: 4px; margin-top: 1rem;">Panel Profesor</a>
        <% } %>

        <a href="/messages" onclick="toggleMobileMenu()">
            Mis Mensajes
            <% if (locals.mensajesNoLeidos && locals.mensajesNoLeidos > 0) { %>
                <span style="background: #e53e3e; color: white; border-radius: 50%; padding: 0.1rem 0.4rem; font-size: 0.75rem; font-weight: bold; margin-left: 0.3rem;"><%= locals.mensajesNoLeidos %></span>
            <% } %>
        </a>

        <a href="/mis-cursos" onclick="toggleMobileMenu()">Mis Cursos</a>
        <a href="/auth/profile" onclick="toggleMobileMenu()">Mi Perfil</a>
        <a href="/auth/logout" onclick="toggleMobileMenu()" style="color: #feb2b2;">Cerrar Sesión</a>
    <% } else { %>
        <a href="/auth/login" onclick="toggleMobileMenu()">Iniciar Sesión</a>
        <a href="/auth/register" onclick="toggleMobileMenu()" style="background: white; color: #0b2238; padding: 0.6rem 1.3rem; border-radius: 6px; text-align: center; margin-top: 1rem;">Registrarse</a>
    <% } %>
</div>

<script>
function toggleMobileMenu() {
    const menu = document.querySelector('.mobile-menu');
    const overlay = document.querySelector('.mobile-menu-overlay');
    menu.classList.toggle('active');
    overlay.classList.toggle('active');
}
</script>