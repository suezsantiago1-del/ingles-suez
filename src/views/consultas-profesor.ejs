<!DOCTYPE html>
<html lang="es">
<head>
    <link rel="icon" type="image/svg+xml" href="/img/favicon-suez.svg">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Consultas de alumnos · Panel del profesor · Inglés Suez</title>
</head>
<body class="tema-flyer">

    <%- include('partials/header') %>

    <%
        const lista = Array.isArray(consultas) ? consultas : [];
        const sinResponder = lista.filter(c => !c.respuesta_profesor).length;
        const fecha = (f) => f ? new Date(f).toLocaleString('es-AR', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }) : '';
        const inicial = (n) => (n || '?').trim().charAt(0).toUpperCase();
    %>

    <main class="fx-page">
        <%- include('partials/teacher-tabs', { activa: '/profesor/consultas' }) %>

        <div class="fx-block__head" style="margin: 2.2rem 0 1.6rem;">
            <h1 class="fx-page__title">Consultas <span class="fx-steel">de alumnos</span></h1>
            <p><%= sinResponder === 0 ? 'Estás al día: no hay consultas sin responder.' : (sinResponder === 1 ? 'Hay 1 consulta sin responder.' : 'Hay ' + sinResponder + ' consultas sin responder.') %> Los alumnos las hacen desde cada clase del aula.</p>
        </div>

        <% if (lista.length > 0) { %>
            <div class="fx-seg" role="group" aria-label="Filtrar consultas" style="margin-bottom: 1.2rem;">
                <button type="button" data-filtro="pendientes" aria-pressed="<%= sinResponder > 0 ? 'true' : 'false' %>">Sin responder <span class="fx-badge-count"><%= sinResponder %></span></button>
                <button type="button" data-filtro="todas" aria-pressed="<%= sinResponder > 0 ? 'false' : 'true' %>">Todas</button>
            </div>

            <div id="consultas-alumnos" class="fx-entregas" style="padding: 0; overflow: visible;">
                <% lista.forEach(c => { const respondida = !!c.respuesta_profesor; %>
                    <article class="fx-entrega<%= respondida ? '' : ' is-pendiente' %>" data-pendiente="<%= respondida ? '0' : '1' %>">
                        <header class="fx-entrega__head">
                            <div style="display: flex; gap: 0.8rem; align-items: center; min-width: 0;">
                                <span class="fx-avatar" aria-hidden="true"><%= inicial(c.usuario_nombre) %></span>
                                <div style="min-width: 0;">
                                    <strong style="color: var(--fx-text);"><%= c.usuario_nombre %></strong>
                                    <span class="fx-entrega__fecha" style="display: block; white-space: normal;"><%= c.curso_titulo %> · <%= c.leccion_titulo %></span>
                                </div>
                            </div>
                            <span class="fx-entrega__fecha"><%= fecha(c.fecha) %></span>
                        </header>

                        <div class="fx-entrega__resp">
                            <p><%= c.mensaje %></p>
                        </div>

                        <% if (respondida) { %>
                            <div class="fx-entrega__dev">
                                <div>
                                    <span>Tu respuesta</span>
                                    <p><%= c.respuesta_profesor %></p>
                                </div>
                            </div>
                        <% } %>

                        <details class="fx-entrega__form" <%= respondida ? '' : 'open' %>>
                            <summary><%= respondida ? 'Editar respuesta' : 'Responder' %></summary>
                            <label for="respuesta-consulta-<%= c.id %>" class="fx-sr">Respuesta</label>
                            <textarea class="fx-input" id="respuesta-consulta-<%= c.id %>" rows="3" placeholder="Escribí tu respuesta" style="margin-bottom: 0.8rem;"><%= c.respuesta_profesor || '' %></textarea>
                            <button type="button" class="fx-btn fx-btn--solid fx-btn--sm" onclick="responderConsulta(<%= c.id %>)"><%= respondida ? 'Actualizar respuesta' : 'Enviar respuesta' %></button>
                        </details>
                    </article>
                <% }) %>
                <p class="fx-chat__empty-list" id="fx-lista-vacia" hidden>No hay consultas sin responder.</p>
            </div>
        <% } else { %>
            <div class="fx-panel" style="text-align: center; padding: 3rem 1.5rem;">
                <h2>Todavía no hay consultas</h2>
                <p style="margin: 0;">Cuando un alumno pregunte algo desde una clase, aparece acá.</p>
            </div>
        <% } %>
    </main>

    <%- include('partials/footer') %>

    <script>
    // Filtro "Sin responder / Todas"
    (function () {
        var botones = document.querySelectorAll('[data-filtro]');
        if (!botones.length) return;
        function aplicar(filtro) {
            var visibles = 0;
            document.querySelectorAll('#consultas-alumnos .fx-entrega').forEach(function (a) {
                a.hidden = filtro === 'pendientes' && a.dataset.pendiente !== '1';
                if (!a.hidden) visibles++;
            });
            document.getElementById('fx-lista-vacia').hidden = visibles > 0;
        }
        botones.forEach(function (b) {
            b.addEventListener('click', function () {
                botones.forEach(function (o) { o.setAttribute('aria-pressed', o === b ? 'true' : 'false'); });
                aplicar(b.dataset.filtro);
            });
        });
        var activo = document.querySelector('[data-filtro][aria-pressed="true"]');
        aplicar(activo ? activo.dataset.filtro : 'todas');
    })();
    </script>
    <script>
// Responder/actualizar consultas de alumnos por lección
        function responderConsulta(consultaId) {
            const textarea = document.getElementById('respuesta-consulta-' + consultaId);
            const respuesta = textarea ? textarea.value.trim() : '';
            if (!respuesta) { alert('Escribe una respuesta antes de enviarla.'); return; }
            fetch('/profesor/consulta/responder', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ consultaId, respuesta })
            })
                .then(r => r.json())
                .then(data => {
                    if (data.success) {
                        alert('Respuesta guardada.');
                        window.location.reload();
                    } else {
                        alert(data.message || 'No se pudo guardar la respuesta.');
                    }
                })
                .catch(() => alert('Error de conexión al guardar la respuesta.'));
        }
    </script>
</body>
</html>