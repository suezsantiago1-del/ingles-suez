<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Clases Particulares - INGLÉS SUEZ</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=GFS+Didot&family=Tenor+Sans&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/styles.css">
    <style>
        body, p, span, div, a, li, label, input, textarea, select { font-family: 'GFS Didot', serif; }
        h1, h2, h3, h4, h5, h6, button { font-family: 'Tenor Sans', sans-serif !important; }
        body { background-color: #e3edf5; margin: 0; padding: 0; color: #1a202c; }
    </style>
</head>
<body>

    <%- include('partials/header') %>

    <main style="max-width: 950px; margin: 4rem auto; padding: 0 1.5rem;">
        <div style="background: white; border-radius: 12px; padding: 3rem; box-shadow: 0 15px 35px rgba(11, 34, 56, 0.15), 0 5px 15px rgba(0, 0, 0, 0.05); border: 1px solid #c0d4e5;">
            
            <span style="background: #184168; color: white; padding: 0.35rem 0.8rem; border-radius: 4px; font-size: 0.75rem; letter-spacing: 1px; text-transform: uppercase;">
                ENSEÑANZA PERSONALIZADA
            </span>

            <h1 style="color: #0b2238; font-size: 2.3rem; margin: 1.5rem 0 1rem 0;">
                CLASES PARTICULARES 1 A 1
            </h1>

            <p style="color: #4a5568; font-size: 1.15rem; line-height: 1.7; margin-bottom: 2rem;">
                ¿Necesitas preparar un examen específico, mejorar tu conversación para un trabajo o aprender a tu propio ritmo? Las clases individuales adaptan el contenido al 100% a tus objetivos particulares.
            </p>

            <!-- Sección de Modalidades -->
            <h2 style="color: #0b2238; font-size: 1.5rem; margin-bottom: 1rem;">Modalidades Disponibles</h2>
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 1.5rem; margin-bottom: 2.5rem;">
                <div style="background: #f0f6fa; padding: 1.5rem; border-radius: 8px; border: 1px solid #c0d4e5;">
                    <h3 style="color: #0b2238; margin-top: 0; font-size: 1.15rem;">Clases Online</h3>
                    <p style="color: #4a5568; margin-bottom: 0; font-size: 0.95rem; line-height: 1.6;">En vivo mediante Google Meet o Zoom, con material digital interactivo y flexibilidad desde cualquier lugar.</p>
                </div>

                <div style="background: #f0f6fa; padding: 1.5rem; border-radius: 8px; border: 1px solid #c0d4e5;">
                    <h3 style="color: #0b2238; margin-top: 0; font-size: 1.15rem;">Clases Presenciales</h3>
                    <p style="color: #4a5568; margin-bottom: 0; font-size: 0.95rem; line-height: 1.6;">Encuentros individuales presenciales enfocados en práctica oral intensiva y seguimiento cercano.</p>
                </div>

                <div style="background: #f0f6fa; padding: 1.5rem; border-radius: 8px; border: 1px solid #c0d4e5;">
                    <h3 style="color: #0b2238; margin-top: 0; font-size: 1.15rem;">Clases a Domicilio</h3>
                    <p style="color: #4a5568; margin-bottom: 0; font-size: 0.95rem; line-height: 1.6;">Atención personalizada en la comodidad de tu hogar o lugar de trabajo con horarios coordinados a conveniencia.</p>
                </div>
            </div>

            <!-- Formulario de Consulta directa -->
            <div style="border-top: 2px solid #e3edf5; padding-top: 2rem;">
                <h2 style="color: #0b2238; font-size: 1.6rem; margin-top: 0; margin-bottom: 0.5rem;">Solicitar Información o Agendar Clase</h2>
                <p style="color: #718096; margin-bottom: 1.5rem;">Completa el formulario y te responderemos por nuestro canal interno a la brevedad.</p>

                <% if (user) { %>
                    <form id="form-consulta-particular" style="display: flex; flex-direction: column; gap: 1.2rem;">
                        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem;">
                            <div>
                                <label style="display: block; color: #0b2238; font-weight: bold; margin-bottom: 0.4rem;">Modalidad Preferida:</label>
                                <select id="modalidad" name="modalidad" style="width: 100%; padding: 0.75rem; border: 1px solid #cbd5e0; border-radius: 6px; font-size: 1rem; box-sizing: border-box;" required>
                                    <option value="Online">Online</option>
                                    <option value="Presencial">Presencial</option>
                                    <option value="A Domicilio">A Domicilio</option>
                                </select>
                            </div>

                            <div>
                                <label style="display: block; color: #0b2238; font-weight: bold; margin-bottom: 0.4rem;">Objetivo Principal:</label>
                                <select id="objetivo" name="objetivo" style="width: 100%; padding: 0.75rem; border: 1px solid #cbd5e0; border-radius: 6px; font-size: 1rem; box-sizing: border-box;" required>
                                    <option value="Conversación y Fluidez">Conversación y Fluidez</option>
                                    <option value="Preparación de Examen">Preparación de Examen</option>
                                    <option value="Inglés desde Cero">Inglés desde Cero</option>
                                    <option value="Inglés Laboral / Entrevistas">Inglés Laboral / Entrevistas</option>
                                </select>
                            </div>
                        </div>

                        <div>
                            <label style="display: block; color: #0b2238; font-weight: bold; margin-bottom: 0.4rem;">Mensaje o Consulta:</label>
                            <textarea id="mensaje" name="mensaje" rows="4" required placeholder="Cuéntame sobre tu disponibilidad horaria, barrio o dudas particulares..." style="width: 100%; padding: 0.75rem; border: 1px solid #cbd5e0; border-radius: 6px; font-size: 1rem; box-sizing: border-box;"></textarea>
                        </div>

                        <button type="submit" id="btn-submit" style="background: #0b2238; color: white; border: none; padding: 0.9rem 2rem; border-radius: 6px; font-size: 1rem; cursor: pointer; align-self: flex-start;">
                            Enviar Consulta
                        </button>
                    </form>
                <% } else { %>
                    <div style="background: #fffaf0; border: 1px solid #feebc8; padding: 1.5rem; border-radius: 8px; text-align: center;">
                        <p style="margin: 0; color: #c05621; font-weight: bold;">Debes iniciar sesión para enviar una consulta sobre clases particulares.</p>
                        <a href="/auth/login" style="display: inline-block; margin-top: 0.8rem; background: #0b2238; color: white; padding: 0.6rem 1.2rem; border-radius: 6px; text-decoration: none; font-size: 0.9rem;">Iniciar Sesión</a>
                    </div>
                <% } %>
            </div>

            <!-- Bandeja de Consultas Realizadas por el Alumno -->
            <% if (user && typeof misConsultas !== 'undefined' && misConsultas.length > 0) { %>
                <div style="border-top: 2px solid #e3edf5; margin-top: 3rem; padding-top: 2rem;">
                    <h2 style="color: #0b2238; font-size: 1.5rem; margin-bottom: 1.5rem;">Mis Consultas de Clases Particulares</h2>
                    <div style="display: flex; flex-direction: column; gap: 1.2rem;">
                        <% misConsultas.forEach(c => { %>
                            <div style="background: #f8fafc; border: 1px solid #cbd5e0; border-radius: 8px; padding: 1.2rem;">
                                <div style="display: flex; justify-content: space-between; font-size: 0.85rem; color: #718096; margin-bottom: 0.5rem;">
                                    <span><strong>Modalidad:</strong> <%= c.modalidad %> | <strong>Objetivo:</strong> <%= c.objetivo %></span>
                                    <span><%= new Date(c.fecha_consulta).toLocaleDateString('es-AR') %></span>
                                </div>
                                <p style="margin: 0.5rem 0; color: #2d3748; font-style: italic;">"<%= c.mensaje_alumno %>"</p>

                                <% if (c.respuesta_profesor) { %>
                                    <div style="background: #ebf8ff; border-left: 4px solid #3182ce; padding: 0.8rem 1rem; margin-top: 0.8rem; border-radius: 0 6px 6px 0;">
                                        <span style="display: block; font-weight: bold; color: #2b6cb0; font-size: 0.85rem; margin-bottom: 0.2rem;">Respuesta del Profesor:</span>
                                        <p style="margin: 0; color: #2d3748; white-space: pre-wrap;"><%= c.respuesta_profesor %></p>
                                    </div>
                                <% } else { %>
                                    <span style="display: inline-block; margin-top: 0.5rem; font-size: 0.8rem; color: #d69e2e; background: #fefcbf; padding: 0.2rem 0.6rem; border-radius: 4px;">Pendiente de respuesta</span>
                                <% } %>
                            </div>
                        <% }) %>
                    </div>
                </div>
            <% } %>

        </div>
    </main>

    <%- include('partials/footer') %>

    <script>
        const form = document.getElementById('form-consulta-particular');
        if (form) {
            form.addEventListener('submit', async (e) => {
                e.preventDefault();
                const btn = document.getElementById('btn-submit');
                const modalidad = document.getElementById('modalidad').value;
                const objetivo = document.getElementById('objetivo').value;
                const mensaje = document.getElementById('mensaje').value;

                btn.disabled = true;
                btn.innerText = 'Enviando...';

                try {
                    const res = await fetch('/particulares/consulta', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ modalidad, objetivo, mensaje })
                    });

                    const data = await res.json();

                    if (data.success) {
                        alert(data.message);
                        window.location.reload();
                    } else {
                        alert(data.message || 'Error al enviar la consulta.');
                        btn.disabled = false;
                        btn.innerText = 'Enviar Consulta';
                    }
                } catch (err) {
                    console.error(err);
                    alert('Error de conexión al enviar la consulta.');
                    btn.disabled = false;
                    btn.innerText = 'Enviar Consulta';
                }
            });
        }
    </script>
</body>
</html>