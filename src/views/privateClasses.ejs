<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Clases Particulares - INGLÉS SUEZ</title>
    <link rel="stylesheet" href="/css/styles.css">
    <style>
        .particulares-container { 
            max-width: 1200px; 
            margin: 2rem auto; 
            padding: 0 1rem; 
            display: grid; 
            grid-template-columns: 1fr 1fr; 
            gap: 2rem; 
        }
        .card-box { 
            background: white; 
            border-radius: 8px; 
            padding: 1.8rem; 
            border: 1px solid #cbd5e0; 
            box-shadow: 0 2px 8px rgba(0,0,0,0.04); 
        }
        .card-box h2 { 
            color: #0b2238; 
            margin-top: 0; 
            font-size: 1.3rem; 
            border-bottom: 2px solid #0b2238; 
            padding-bottom: 0.5rem; 
        }
        
        .chat-card { 
            background: #ffffff; 
            border: 1px solid #cbd5e0; 
            border-radius: 8px; 
            padding: 1.2rem; 
            margin-bottom: 1.2rem; 
            box-shadow: 0 2px 5px rgba(0,0,0,0.02);
        }
        .badge-tag { 
            background: #184168; 
            color: white; 
            padding: 0.2rem 0.6rem; 
            border-radius: 4px; 
            font-size: 0.75rem; 
            font-weight: bold; 
        }
        .badge-obj {
            background: #edf2f7;
            color: #2d3748;
            padding: 0.2rem 0.6rem;
            border-radius: 4px;
            font-size: 0.75rem;
            font-weight: 600;
        }

        /* ESTILOS DEL HILO DEL CHAT */
        .chat-thread {
            display: flex;
            flex-direction: column;
            gap: 0.6rem;
            margin: 1rem 0;
            max-height: 250px;
            overflow-y: auto;
            padding-right: 0.3rem;
        }
        .chat-msg {
            padding: 0.7rem 0.9rem;
            border-radius: 8px;
            font-size: 0.9rem;
            max-width: 88%;
            white-space: pre-wrap;
            line-height: 1.4;
        }
        .chat-msg-alumno {
            background: #e2e8f0;
            color: #2d3748;
            align-self: flex-end;
            border-bottom-right-radius: 2px;
        }
        .chat-msg-profesor {
            background: #e2ebd5;
            color: #1a202c;
            align-self: flex-start;
            border-bottom-left-radius: 2px;
            border-left: 3px solid #184168;
        }
        .chat-msg-header {
            font-size: 0.75rem;
            font-weight: bold;
            margin-bottom: 0.2rem;
            display: flex;
            justify-content: space-between;
            gap: 0.5rem;
        }

        .reply-box {
            display: flex;
            gap: 0.5rem;
            margin-top: 0.8rem;
            border-top: 1px solid #edf2f7;
            padding-top: 0.8rem;
        }
        .reply-input {
            flex: 1;
            padding: 0.5rem 0.8rem;
            border: 1px solid #cbd5e0;
            border-radius: 6px;
            font-family: inherit;
            font-size: 0.88rem;
            resize: none;
            height: 38px;
        }
        .reply-btn {
            background: #184168;
            color: white;
            border: none;
            border-radius: 6px;
            padding: 0 1rem;
            font-weight: bold;
            font-size: 0.85rem;
            cursor: pointer;
            white-space: nowrap;
        }

        @media (max-width: 850px) {
            .particulares-container { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>

    <%- include('partials/header') %>

    <div class="particulares-container" style="<%= singleChatMode ? 'grid-template-columns: 1fr;' : '' %>">
        
        <!-- FORMULARIO DE SOLICITUD -->
        <% if (!singleChatMode) { %>
        <div class="card-box">
            <h2>Solicitar Clase Particular</h2>
            <form id="form-consulta-particular">
                <div style="margin-bottom: 1rem;">
                    <label style="display: block; font-weight: bold; margin-bottom: 0.3rem;">Modalidad preferida:</label>
                    <select name="modalidad" required style="width: 100%; padding: 0.6rem; border-radius: 6px; border: 1px solid #cbd5e0;">
                        <option value="Online (1 a 1)">Online (1 a 1)</option>
                        <option value="Presencial">Presencial</option>
                        <option value="Grupal Reducida">Grupal Reducida</option>
                    </select>
                </div>

                <div style="margin-bottom: 1rem;">
                    <label style="display: block; font-weight: bold; margin-bottom: 0.3rem;">Objetivo principal:</label>
                    <select name="objetivo" required style="width: 100%; padding: 0.6rem; border-radius: 6px; border: 1px solid #cbd5e0;">
                        <option value="Preparación de Exámenes">Preparación de Exámenes</option>
                        <option value="Inglés Laboral / Entrevistas">Inglés Laboral / Entrevistas</option>
                        <option value="Conversación y Fluidez">Conversación y Fluidez</option>
                        <option value="Apoyo Escolar / Universitario">Apoyo Escolar / Universitario</option>
                    </select>
                </div>

                <div style="margin-bottom: 1rem;">
                    <label style="display: block; font-weight: bold; margin-bottom: 0.3rem;">Tu consulta o disponibilidad horaria:</label>
                    <textarea name="mensaje" required placeholder="Escribe tus dudas, nivel aproximado o días/horarios disponibles..." style="width: 100%; height: 110px; padding: 0.6rem; border-radius: 6px; border: 1px solid #cbd5e0; font-family: inherit;"></textarea>
                </div>

                <button type="submit" id="btn-enviar" style="width: 100%; background: #184168; color: white; padding: 0.8rem; border: none; border-radius: 6px; font-weight: bold; cursor: pointer; font-size: 1rem;">
                    Enviar Consulta
                </button>
            </form>
        </div>
        <% } %>

        <!-- LISTA DE CONSULTAS Y CHAT CON EL PROFESOR -->
        <div class="card-box">
            <h2>Mis Consultas y Respuestas</h2>

            <% if (typeof misConsultas !== 'undefined' && misConsultas.length > 0) { %>
                <div style="max-height: 520px; overflow-y: auto; padding-right: 0.3rem;">
                    <% const consultasToShow = singleChatMode ? misConsultas.filter(x => x.id == activeConsultaId) : misConsultas; %>
                    <% consultasToShow.forEach(c => { %>
                        <div class="chat-card">
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem; flex-wrap: wrap; gap: 0.3rem;">
                                <div>
                                    <span class="badge-tag"><%= c.modalidad %></span>
                                    <span class="badge-obj"><%= c.objetivo %></span>
                                </div>
                                <span style="font-size: 0.8rem; color: #718096;"><%= new Date(c.fecha_consulta).toLocaleDateString('es-AR') %></span>
                            </div>
                            
                            <!-- HILO DE CONVERSACIÓN DE LA CONSULTA -->
                            <div class="chat-thread">
                                <!-- Mensaje original del alumno -->
                                <div class="chat-msg chat-msg-alumno">
                                    <div class="chat-msg-header">
                                        <span>Tú</span>
                                    </div>
                                    <%= c.mensaje_alumno %>
                                </div>

                                <!-- Historial de respuestas (si existen mensajes persistidos) -->
                                <% if (c.mensajesChat && c.mensajesChat.length > 0) { %>
                                    <% c.mensajesChat.forEach(m => { %>
                                        <div class="chat-msg <%= m.emisor === 'PROFESOR' ? 'chat-msg-profesor' : 'chat-msg-alumno' %>">
                                            <div class="chat-msg-header">
                                                <span><%= m.emisor === 'PROFESOR' ? 'Profesor' : 'Tú' %></span>
                                                <span style="opacity: 0.7; font-weight: normal;"><%= new Date(m.fecha).toLocaleTimeString('es-AR', { hour: '2-digit', minute: '2-digit' }) %></span>
                                            </div>
                                            <%= m.mensaje %>
                                        </div>
                                    <% }) %>
                                <% } else if (c.respuesta_profesor) { %>
                                    <!-- Fallback para compatibilidad previa -->
                                    <div class="chat-msg chat-msg-profesor">
                                        <div class="chat-msg-header">
                                            <span>Profesor</span>
                                        </div>
                                        <%= c.respuesta_profesor %>
                                    </div>
                                <% } %>
                            </div>

                            <% if (!c.respuesta_profesor && (!c.mensajesChat || c.mensajesChat.length === 0)) { %>
                                <div style="background: #fffaf0; border: 1px solid #fbd38d; color: #c05621; padding: 0.6rem; border-radius: 4px; font-size: 0.85rem; margin-top: 0.5rem;">
                                    <em>Consulta recibida. El profesor te responderá a la brevedad.</em>
                                </div>
                            <% } %>

                            <!-- INPUT PARA RESPONDER DENTRO DEL CHAT -->
                            <form class="form-responder-chat reply-box" data-consulta-id="<%= c.id %>">
                                <textarea name="mensaje" class="reply-input" placeholder="Escribe un mensaje..." required></textarea>
                                <button type="submit" class="reply-btn">Enviar</button>
                            </form>
                        </div>
                    <% }) %>
                </div>
            <% } else { %>
                <div style="text-align: center; padding: 3rem 1rem; color: #a0aec0;">
                    <div style="font-size: 2.5rem; margin-bottom: 0.5rem;"> </div>
                    <p style="margin: 0;">Aún no has realizado consultas de clases particulares.</p>
                    <small>Completa el formulario para enviar tu solicitud al profesor.</small>
                </div>
            <% } %>
        </div>

    </div>

    <%- include('partials/footer') %>

    <script>
        // Formulario principal de nueva solicitud
        const form = document.getElementById('form-consulta-particular');
        if (form) {
            form.addEventListener('submit', async (e) => {
                e.preventDefault();
                const btn = document.getElementById('btn-enviar');
                btn.disabled = true;
                btn.innerText = 'Enviando...';

                const formData = new FormData(form);
                const data = Object.fromEntries(formData.entries());

                try {
                    const res = await fetch('/clases-particulares/enviar', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(data)
                    });

                    const resData = await res.json();

                    if (resData.success) {
                        alert(resData.message);
                        window.location.reload();
                    } else {
                        alert(resData.message || 'Error al enviar la consulta.');
                        btn.disabled = false;
                        btn.innerText = 'Enviar Consulta';
                    }
                } catch (err) {
                    console.error(err);
                    alert('Error de conexión al enviar la consulta.');
                    btn.disabled = false;
                    btn.innerText = 'Enviar Consulta';
                }
            });
        }

        // Formularios de respuestas continuas en el chat
        document.querySelectorAll('.form-responder-chat').forEach(f => {
            f.addEventListener('submit', async (e) => {
                e.preventDefault();
                const consultaId = f.getAttribute('data-consulta-id');
                const textarea = f.querySelector('textarea');
                const btn = f.querySelector('button');
                const mensaje = textarea.value.trim();

                if (!mensaje) return;

                btn.disabled = true;

                try {
                    const res = await fetch('/clases-particulares/enviar-mensaje', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ consultaId, mensaje })
                    });

                    const resData = await res.json();

                    if (resData.success) {
                        window.location.reload();
                    } else {
                        alert(resData.message || 'Error al enviar mensaje.');
                        btn.disabled = false;
                    }
                } catch (err) {
                    console.error(err);
                    alert('Error de conexión.');
                    btn.disabled = false;
                }
            });
        });
    </script>
</body>
</html>