<!DOCTYPE html>
<html lang="es">
<head>
    <link rel="icon" type="image/png" href="/img/favicon.png">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mis mensajes · Inglés Suez</title>
</head>
<body class="tema-flyer">
    <%- include('partials/header') %>

    <main class="fx-page">
        <div class="fx-block__head" style="margin: 0 0 2.2rem;">
            <div>
                <h1 class="fx-page__title">Mis <span class="fx-steel">mensajes</span></h1>
                <p class="fx-page__lead">Las correcciones del profesor a tus entregas, ordenadas por curso.</p>
            </div>
            <% if (locals.mensajesNoLeidos && locals.mensajesNoLeidos > 0) { %>
                <div style="text-align: right;">
                    <button type="button" class="fx-btn fx-btn--sm" id="btn-leidos">Marcar todo como leído</button>
                    <p class="fx-status" id="leidos-status" role="status" style="margin-top: 0.5rem;"></p>
                </div>
            <% } %>
        </div>

        <div class="fx-grid">
            <!-- Las clases particulares también son mensajes con el profesor -->
            <a href="/clases-particulares#mis-consultas" class="fx-card fx-card--link">
                <div class="fx-card__body">
                    <span class="fx-card__tag">Chat</span>
                    <h3>Clases particulares</h3>
                    <p>Tus consultas y la conversación con el profesor para coordinar clases.</p>
                    <span class="fx-card__more">Abrir chat</span>
                </div>
            </a>

            <% if (cursos && cursos.length > 0) { %>
                <% cursos.forEach(c => { %>
                    <a href="/messages/<%= c.id %>" class="fx-card fx-card--link">
                        <div class="fx-card__body">
                            <span class="fx-card__tag">Curso</span>
                            <h3><%= c.titulo %></h3>
                            <p>Devoluciones y notas de cada clase que entregaste.</p>
                            <span class="fx-card__more">Ver devoluciones</span>
                        </div>
                    </a>
                <% }) %>
            <% } else { %>
                <div class="fx-card">
                    <div class="fx-card__body">
                        <h3>Todavía no tenés cursos</h3>
                        <p>Cuando compres un curso, las correcciones de tus entregas van a aparecer acá.</p>
                        <a href="/cursos-todos" class="fx-btn fx-btn--sm" style="align-self: flex-start;">Ver cursos</a>
                    </div>
                </div>
            <% } %>
        </div>
    </main>

    <%- include('partials/footer') %>

    <script>
    (function () {
        var btn = document.getElementById('btn-leidos');
        if (!btn) return;
        btn.addEventListener('click', async function () {
            var status = document.getElementById('leidos-status');
            btn.disabled = true;
            status.classList.remove('is-error');
            try {
                var res = await fetch('/messages/leer', { method: 'POST' });
                var data = await res.json();
                if (!data.success) throw new Error(data.message);
                status.textContent = 'Listo, todo marcado como leído.';
                document.querySelectorAll('.fx-badge-count').forEach(function (b) { b.remove(); });
                btn.remove();
            } catch (err) {
                status.classList.add('is-error');
                status.textContent = 'No se pudo marcar. Probá de nuevo.';
                btn.disabled = false;
            }
        });
    })();
    </script>
</body>
</html>
