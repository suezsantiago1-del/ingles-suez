<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bandeja de Mensajes - INGLÉS SUEZ</title>
    <link rel="stylesheet" href="/css/styles.css">
    <style>
        .container-mensajes { max-width: 850px; margin: 3rem auto; padding: 0 1.5rem; }
        .mensaje-card { background: #ffffff; border: 1px solid #cbd5e0; border-radius: 8px; padding: 1.5rem; margin-bottom: 1.5rem; box-shadow: 0 2px 8px rgba(0,0,0,0.05); }
        .badge { background: #e2ebd5; color: #184168; padding: 0.2rem 0.6rem; border-radius: 4px; font-size: 0.8rem; font-weight: bold; }
        .badge-nota { background: #2b6cb0; color: #ffffff; padding: 0.2rem 0.6rem; border-radius: 4px; font-size: 0.85rem; font-weight: bold; margin-right: 0.5rem; }
    </style>
</head>
<body>

    <%- include('partials/header') %>

    <main class="container-mensajes">
        <h1 style="color: #0b2238;">Mis Mensajes y Devoluciones</h1>
        <p style="color: #4a5568;">Aquí encontrarás las correcciones y observaciones enviadas por el profesor sobre tus tareas:</p>

        <% if (mensajes && mensajes.length > 0) { %>
            <% mensajes.forEach(m => { %>
                <div class="msg-card">
                    <div class="msg-header">
                        <div style="display:flex; align-items:center; gap:0.75rem;">
                            <span class="course-badge"><%= m.curso_titulo %></span>
                        </div>

                        <div class="nota-timestamp">
                            <% if (m.nota !== null && m.nota !== undefined) { %>
                                <span class="nota-badge">Calif: <%= m.nota %>/10</span>
                            <% } %>
                            <span><%= new Date(m.fecha).toLocaleString('es-AR') %></span>
                        </div>
                    </div>

                    <div class="lesson-title"><%= m.leccion_titulo %></div>

                    <div class="bubble-student">
                        <strong style="display:block; color:#0b2238; margin-bottom:0.35rem;">Tu entrega enviada</strong>
                        <div style="color:#334155; font-size:0.95rem;"><%= m.entrega_alumno %></div>
                    </div>

                    <div class="bubble-teacher">
                        <strong style="display:block; color:var(--accent-blue); margin-bottom:0.35rem;">Devolución del Profesor</strong>
                        <div style="color:#0f172a; font-size:0.95rem;"><%= m.mensaje %></div>
                    </div>
                </div>
            <% }); %>
        <% } else { %>
            <div class="messages-empty">Aún no tienes mensajes o devoluciones del profesor.</div>
        <% } %>
    </main>

    <%- include('partials/footer') %>

</body>
</html>