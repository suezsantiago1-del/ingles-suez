<!DOCTYPE html>
<html lang="es">
<head>
    <link rel="icon" type="image/svg+xml" href="/img/favicon-suez.svg">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mi perfil · Inglés Suez</title>
</head>
<body class="tema-flyer">
    <%- include('partials/header') %>

    <% const nombre = (locals.usuario && usuario.nombre) ? usuario.nombre : (locals.user ? user.nombre : '');
       const email = (locals.usuario && usuario.email) ? usuario.email : (locals.user ? user.email : ''); %>

    <main class="fx-page" style="max-width: 860px;">
        <div class="fx-profile__head">
            <span class="fx-avatar fx-avatar--lg" aria-hidden="true"><%= (nombre || '?').trim().charAt(0).toUpperCase() %></span>
            <div>
                <h1 class="fx-page__title">Mi <span class="fx-steel">perfil</span></h1>
                <p class="fx-page__lead" style="margin: 0.3rem 0 0;"><%= email %></p>
            </div>
        </div>

        <% if (locals.error) { %>
            <p class="fx-alert is-error" role="alert"><%= error %></p>
        <% } %>
        <% if (locals.success) { %>
            <p class="fx-alert is-ok" role="status"><%= success %></p>
        <% } %>

        <div class="fx-profile">
            <section class="fx-panel">
                <h2>Tus datos</h2>
                <p>Así aparecés en tus entregas y en tu certificado.</p>
                <form action="/auth/profile/update" method="POST">
                    <div class="fx-field">
                        <label for="nombre">Nombre y apellido</label>
                        <input class="fx-input" type="text" id="nombre" name="nombre" value="<%= nombre %>" autocomplete="name" required>
                    </div>
                    <div class="fx-field">
                        <label for="email">Email</label>
                        <input class="fx-input" type="email" id="email" name="email" value="<%= email %>" autocomplete="email" required>
                    </div>
                    <button type="submit" class="fx-btn fx-btn--solid fx-btn--sm">Guardar cambios</button>
                </form>
            </section>

            <section class="fx-panel">
                <h2>Contraseña</h2>
                <p>Para cambiarla, primero confirmá la actual.</p>
                <form action="/auth/profile/password" method="POST">
                    <div class="fx-field">
                        <label for="currentPassword">Contraseña actual</label>
                        <div class="fx-pass">
                            <input class="fx-input" type="password" id="currentPassword" name="currentPassword" autocomplete="current-password" required>
                            <button type="button" aria-pressed="false">Mostrar</button>
                        </div>
                    </div>
                    <div class="fx-field">
                        <label for="newPassword">Contraseña nueva</label>
                        <div class="fx-pass">
                            <input class="fx-input" type="password" id="newPassword" name="newPassword" minlength="6" autocomplete="new-password" required>
                            <button type="button" aria-pressed="false">Mostrar</button>
                        </div>
                    </div>
                    <p class="fx-hint">Mínimo 6 caracteres.</p>
                    <button type="submit" class="fx-btn fx-btn--sm">Cambiar contraseña</button>
                </form>
            </section>
        </div>

        <nav class="fx-profile__links" aria-label="Accesos rápidos">
            <a href="/mis-cursos" class="fx-btn fx-btn--sm">Mis cursos</a>
            <a href="/messages" class="fx-btn fx-btn--sm">Mis mensajes</a>
            <a href="/auth/forgot-password" class="fx-profile__forgot">¿No te acordás de tu contraseña?</a>
        </nav>
    </main>

    <%- include('partials/footer') %>
    <%- include('partials/auth-pass') %>
</body>
</html>
