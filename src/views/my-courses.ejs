<!DOCTYPE html>
<html lang="es">
<head>
    <link rel="icon" type="image/jpg" href="/img/logo.jpg">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mis Cursos - INGLÉS SUEZ</title>
    <link rel="stylesheet" href="/css/styles.css">
    <style>
        .courses-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 1.5rem;
            margin-top: 2rem;
        }
        .course-card {
            background: #ffffff;
            border: 1px solid #cbd5e0;
            border-radius: 8px;
            padding: 1.5rem;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }
    </style>
</head>
<body>

    <%- include('partials/header') %>

    <main style="max-width: 1000px; margin: 3rem auto; padding: 0 1.5rem;">
        <h1 style="color: #0b2238;">Mis Cursos</h1>
        <p style="color: #4a5568;">Accede a tus programas de formación activos:</p>

        <div class="courses-grid">
            <% if (cursos && cursos.length > 0) { %>
                <% cursos.forEach(curso => { %>
                    <div class="course-card">
                        <div>
                            <h3 style="color: #0b2238; margin-top: 0;"><%= curso.titulo %></h3>
                            <p style="color: #718096; font-size: 0.9rem;"><%= curso.descripcion %></p>
                        </div>
                        <div style="margin-top: 1.5rem;">
                            <a href="/classroom/<%= curso.id %>" style="display: block; text-align: center; background: #184168; color: white; padding: 0.7rem; border-radius: 6px; text-decoration: none; font-weight: bold;">
                                Ver curso
                            </a>
                        </div>
                    </div>
                <% }); %>
            <% } else { %>
                <p style="color: #718096;">Aún no estás inscripto en ningún curso.</p>
            <% } %>
        </div>
    </main>

    <%- include('partials/footer') %>

</body>
</html>