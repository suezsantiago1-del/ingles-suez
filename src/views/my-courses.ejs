<!DOCTYPE html>
<html lang="es">
<head>
    <link rel="icon" type="image/svg+xml" href="/img/favicon-suez.svg">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mis cursos · Inglés Suez</title>
</head>
<body class="tema-flyer">
    <%- include('partials/header') %>

    <main class="fx-page">
        <div class="fx-block__head" style="margin: 0 0 2.2rem;">
            <div>
                <h1 class="fx-page__title">Mis <span class="fx-steel">cursos</span></h1>
                <p class="fx-page__lead">Seguí desde la última clase que dejaste.</p>
            </div>
        </div>

        <div class="fx-grid">
            <% if (cursos && cursos.length > 0) { %>
                <% cursos.forEach(curso => { %>
                    <a href="/classroom/<%= curso.id %>" class="fx-card fx-card--link">
                        <div class="fx-card__media">
                            <img src="<%= (curso.id == 1 || curso.titulo.toLowerCase().includes('intensivo')) ? '/img/logo_2.png?v=2' : '/img/logo_3.png?v=2' %>" alt="" loading="lazy">
                        </div>
                        <div class="fx-card__body">
                            <span class="fx-card__tag">Curso online</span>
                            <h2 class="fx-card__h"><%= curso.titulo %></h2>
                            <p><%= curso.descripcion %></p>
                            <span class="fx-card__more">Entrar al aula</span>
                        </div>
                    </a>
                <% }); %>
            <% } else { %>
                <div class="fx-card">
                    <div class="fx-card__body">
                        <h2 class="fx-card__h">Todavía no tenés cursos</h2>
                        <p>Cuando compres un curso, aparece acá y entrás al aula con un clic.</p>
                        <a href="/cursos-todos" class="fx-btn fx-btn--sm" style="align-self: flex-start;">Ver cursos</a>
                    </div>
                </div>
            <% } %>
        </div>
    </main>

    <%- include('partials/footer') %>
</body>
</html>
