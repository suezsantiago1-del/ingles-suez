<!DOCTYPE html>
<html lang="es">
<head>
    <link rel="icon" type="image/svg+xml" href="/img/favicon-suez.svg">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Crear cuenta · Inglés Suez</title>
</head>
<body class="tema-flyer">
    <%- include('partials/header') %>

    <main class="fx-auth">
        <div class="fx-auth__card">
            <%- include('partials/auth-star') %>
            <span class="fx-auth__eyebrow">Empezá hoy</span>
            <h1 class="fx-auth__title">Creá tu <span class="fx-steel">cuenta</span></h1>
            <p class="fx-auth__lead">Con tu cuenta accedés a los cursos online, entregás tareas y recibís las correcciones del profesor.</p>

            <% if (locals.error) { %>
                <p class="fx-alert is-error" role="alert"><%= error %></p>
            <% } %>

            <form action="/auth/register" method="POST">
                <div class="fx-field">
                    <label for="nombre">Nombre y apellido</label>
                    <input class="fx-input" type="text" id="nombre" name="nombre" autocomplete="name" required autofocus>
                </div>
                <div class="fx-field">
                    <label for="email">Email</label>
                    <input class="fx-input" type="email" id="email" name="email" placeholder="tu@email.com" autocomplete="email" required>
                </div>
                <div class="fx-field">
                    <label for="password">Contraseña</label>
                    <div class="fx-pass">
                        <input class="fx-input" type="password" id="password" name="password" minlength="6" autocomplete="new-password" required>
                        <button type="button" aria-pressed="false">Mostrar</button>
                    </div>
                </div>
                <p class="fx-hint">Mínimo 6 caracteres.</p>
                <div class="fx-field">
                    <label for="confirmPassword">Repetí la contraseña</label>
                    <div class="fx-pass">
                        <input class="fx-input" type="password" id="confirmPassword" name="confirmPassword" minlength="6" autocomplete="new-password" required>
                        <button type="button" aria-pressed="false">Mostrar</button>
                    </div>
                </div>
                <button type="submit" class="fx-btn fx-btn--solid">Crear cuenta</button>
            </form>

            <p class="fx-auth__foot">¿Ya tenés cuenta? <a href="/auth/login">Iniciá sesión</a></p>
        </div>
    </main>

    <%- include('partials/footer') %>
    <%- include('partials/auth-pass') %>
</body>
</html>
