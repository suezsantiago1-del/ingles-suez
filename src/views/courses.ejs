<!DOCTYPE html>
<html lang="es">
<head>
    <link rel="icon" type="image/svg+xml" href="/img/favicon-suez.svg">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cursos online · Inglés Suez</title>

    <!-- Google AdSense Verification -->
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-1854686112404128"
         crossorigin="anonymous"></script>
</head>
<body class="tema-flyer">
    <%- include('partials/header') %>

    <main class="fx-page">
        <div class="fx-block__head" style="margin: 0 0 2.4rem;">
            <div>
                <span class="fx-auth__eyebrow">A tu ritmo</span>
                <h1 class="fx-page__title">Cursos <span class="fx-steel">online</span></h1>
                <p class="fx-page__lead">Clases grabadas, ejercicios en cada clase y correcciones personalizadas del profesor. Entrás cuando quieras, desde donde quieras.</p>
            </div>
            <a href="/clases-particulares" class="fx-btn fx-btn--sm">¿Preferís clases en vivo?</a>
        </div>

        <div class="fx-grid">
            <% if (cursos && cursos.length > 0) { %>
                <% cursos.forEach(curso => { %>
                    <% const esIntensivo = curso.titulo === 'Inglés Intensivo Desde Cero' || curso.titulo === 'Ingles Intensivo Desde Cero'; %>
                    <article class="fx-card">
                        <div class="fx-card__media">
                            <img src="<%= (curso.id == 1 || curso.titulo.toLowerCase().includes('intensivo')) ? '/img/logo_2.png?v=2' : '/img/logo_3.png?v=2' %>" alt="<%= curso.titulo %>" loading="lazy">
                        </div>

                        <div class="fx-card__body">
                            <% if (esIntensivo) { %>
                                <span class="fx-card__tag">Certificado A1–A2</span>
                                <h2 class="fx-card__h">Inglés Intensivo Desde Cero</h2>
                            <% } else { %>
                                <h2 class="fx-card__h"><%= curso.titulo %></h2>
                            <% } %>
                            <p><%= curso.descripcion %></p>

                            <ul class="fx-checks">
                                <li>Acceso de por vida</li>
                                <li>Clases en video</li>
                                <li>Ejercicios y correcciones del profesor</li>
                            </ul>

                            <div class="fx-card__foot">
                                <% if (curso && curso.titulo === 'Conversación y Fluidez Real') { %>
                                    <span class="fx-soon">Próximamente</span>
                                <% } else if (locals.comprasIds && locals.comprasIds.includes(curso.id)) { %>
                                    <a href="/classroom/<%= curso.id %>" class="fx-btn fx-btn--solid" style="width: 100%;">Ir al aula</a>
                                <% } else { %>
                                    <span class="fx-price">$<%= curso.precio %><small>ARS</small></span>
                                    <a href="/course/<%= curso.id %>" class="fx-btn fx-btn--sm">Ver curso</a>
                                <% } %>
                            </div>
                        </div>
                    </article>
                <% }); %>
            <% } else { %>
                <p class="fx-empty">Todavía no hay cursos publicados.</p>
            <% } %>
        </div>
    </main>

    <%- include('partials/footer') %>
</body>
</html>
