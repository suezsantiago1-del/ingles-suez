<!DOCTYPE html>
<html lang="es">
<head>
    <link rel="icon" type="image/svg+xml" href="/img/favicon-suez.svg">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Rachas y recompensas · Panel del profesor · Inglés Suez</title>
</head>
<body class="tema-flyer">

<%- include('partials/header') %>

<% const inicial = (n) => (n || '?').trim().charAt(0).toUpperCase(); %>

<main class="fx-page">
    <%- include('partials/teacher-tabs', { activa: '/profesor/rachas' }) %>

    <div class="fx-block__head" style="margin: 2.2rem 0 1.6rem;">
        <h1 class="fx-page__title">Rachas <span class="fx-steel">y recompensas</span></h1>
        <p>Mirá la racha de cada alumno en el desafío del día y mandale una recompensa por texto.</p>
    </div>

    <div class="fx-rachas">
        <section>
            <% if (usuarios && usuarios.length) { %>
                <div class="fx-rachas__list">
                    <% usuarios.forEach(u => { %>
                        <article class="fx-racha">
                            <div class="fx-racha__who">
                                <span class="fx-avatar" aria-hidden="true"><%= inicial(u.nombre) %></span>
                                <div style="min-width: 0;">
                                    <strong><%= u.nombre %></strong>
                                    <span><%= u.email %></span>
                                </div>
                            </div>
                            <dl class="fx-racha__stats">
                                <div><dt>Racha</dt><dd><%= u.racha %> <small>días</small></dd></div>
                                <div><dt>XP</dt><dd><%= u.xpTotal %></dd></div>
                                <div><dt>Hito</dt><dd class="fx-racha__hito"><%= u.hito ? u.hito.emoji + ' ' + u.hito.nombre : '—' %></dd></div>
                            </dl>
                            <form method="POST" action="/profesor/rachas/recompensar" class="fx-racha__form">
                                <input type="hidden" name="usuarioId" value="<%= u.id %>">
                                <label for="premio-<%= u.id %>" class="fx-sr">Recompensa para <%= u.nombre %></label>
                                <input class="fx-input" type="text" id="premio-<%= u.id %>" name="texto" placeholder="Escribí una recompensa" required>
                                <button type="submit" class="fx-btn fx-btn--solid fx-btn--sm">Enviar</button>
                            </form>
                        </article>
                    <% }) %>
                </div>
            <% } else { %>
                <div class="fx-panel" style="text-align: center; padding: 3rem 1.5rem;">
                    <h2>Todavía no hay rachas</h2>
                    <p style="margin: 0;">Cuando los alumnos completen el desafío del día, aparecen acá.</p>
                </div>
            <% } %>
        </section>

        <aside class="fx-reto__panel">
            <h3>Recompensas enviadas</h3>
            <% if (recompensas && recompensas.length) { %>
                <% recompensas.forEach(r => { %>
                    <div class="fx-reto__premio">
                        <small>Para <%= r.nombre %></small>
                        <p><%= r.texto %></p>
                        <small><%= new Date(r.creado_en).toLocaleDateString('es-AR', { day: 'numeric', month: 'short' }) %></small>
                    </div>
                <% }) %>
            <% } else { %>
                <p>Todavía no mandaste recompensas.</p>
            <% } %>
        </aside>
    </div>
</main>

<%- include('partials/footer') %>

</body>
</html>
