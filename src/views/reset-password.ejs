<!DOCTYPE html>
<html lang="es">
<head>
    <link rel="icon" type="image/jpg" href="/img/logo.jpg">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Restablecer Contraseña - INGLÉS SUEZ</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('partials/header') %>
    
    <div class="auth-container">
        <div class="auth-box">
            <h1>Restablecer Contraseña</h1>
            <p>Ingresa tu nueva contraseña.</p>
            
            <% if (error) { %>
                <div class="alert alert-error"><%= error %></div>
            <% } %>
            
            <% if (success) { %>
                <div class="alert alert-success"><%= success %></div>
            <% } %>
            
            <% if (token) { %>
                <form action="/auth/reset-password/<%= token %>" method="POST">
                    <div class="form-group">
                        <label for="password">Nueva Contraseña</label>
                        <input type="password" id="password" name="password" required minlength="6">
                    </div>
                    
                    <div class="form-group">
                        <label for="confirmPassword">Confirmar Contraseña</label>
                        <input type="password" id="confirmPassword" name="confirmPassword" required minlength="6">
                    </div>
                    
                    <button type="submit" class="btn btn-primary">Restablecer Contraseña</button>
                </form>
            <% } else { %>
                <p>El enlace de recuperación no es válido o ha expirado.</p>
                <a href="/auth/forgot-password" class="btn btn-primary">Solicitar Nuevo Enlace</a>
            <% } %>
        </div>
    </div>
    
    <%- include('partials/footer') %>
</body>
</html>