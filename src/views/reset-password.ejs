<!DOCTYPE html>
<html lang="es">
<head>
    <link rel="icon" type="image/svg+xml" href="/img/favicon-suez.svg">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nueva contraseña · Inglés Suez</title>
</head>
<body class="tema-flyer">
    <%- include('partials/header') %>

    <main class="fx-auth">
        <div class="fx-auth__card">
            <%- include('partials/auth-star') %>
            <span class="fx-auth__eyebrow">Tu cuenta</span>
            <h1 class="fx-auth__title">Creá una <span class="fx-steel">contraseña nueva</span></h1>

            <% if (error) { %>
                <p class="fx-alert is-error" role="alert"><%= error %></p>
            <% } %>
            <% if (success) { %>
                <p class="fx-alert is-ok" role="status"><%= success %></p>
            <% } %>

            <% if (token) { %>
                <p class="fx-auth__lead">Elegí una contraseña de al menos 6 caracteres.</p>
                <form action="/auth/reset-password/<%= token %>" method="POST">
                    <div class="fx-field">
                        <label for="password">Contraseña nueva</label>
                        <div class="fx-pass">
                            <input class="fx-input" type="password" id="password" name="password" minlength="6" autocomplete="new-password" required autofocus>
                            <button type="button" aria-pressed="false">Mostrar</button>
                        </div>
                    </div>
                    <div class="fx-field">
                        <label for="confirmPassword">Repetila</label>
                        <div class="fx-pass">
                            <input class="fx-input" type="password" id="confirmPassword" name="confirmPassword" minlength="6" autocomplete="new-password" required>
                            <button type="button" aria-pressed="false">Mostrar</button>
                        </div>
                    </div>
                    <button type="submit" class="fx-btn fx-btn--solid">Guardar contraseña</button>
                </form>
            <% } else { %>
                <p class="fx-auth__lead">Este enlace ya no sirve: venció o ya se usó. Pedí uno nuevo y te llega en un minuto.</p>
                <a href="/auth/forgot-password" class="fx-btn fx-btn--solid" style="width: 100%; justify-content: center;">Pedir un enlace nuevo</a>
            <% } %>

            <p class="fx-auth__foot"><a href="/auth/login">Volver a iniciar sesión</a></p>
        </div>
    </main>

    <%- include('partials/footer') %>
    <%- include('partials/auth-pass') %>
</body>
</html>
