<!DOCTYPE html>
<html lang="es">
<head>
    <link rel="icon" type="image/svg+xml" href="/img/favicon-suez.svg">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= curso.titulo %> · Inglés Suez</title>

    <!-- Google AdSense Verification -->
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-1854686112404128"
         crossorigin="anonymous"></script>
</head>
<body class="tema-flyer">
    <%- include('partials/header') %>

    <% const esIntensivo = curso.id == 1 || curso.titulo.toLowerCase().includes('intensivo'); %>

    <main class="fx-page">
        <a href="/cursos-todos" class="fx-back">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M15 6l-6 6 6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Todos los cursos
        </a>

        <div class="fx-course">
            <div class="fx-course__media">
                <img src="<%= curso.imagen_url || (esIntensivo ? '/img/logo_2.png?v=2' : '/img/logo_3.png?v=2') %>" alt="<%= curso.titulo %>">
            </div>

            <div class="fx-course__info">
                <span class="fx-card__tag"><%= esIntensivo ? 'Certificado A1–A2' : 'Curso online' %></span>
                <h1 class="fx-page__title"><%= curso.titulo %></h1>
                <p class="fx-page__lead"><%= curso.descripcion %></p>

                <div class="fx-course__buy">
                    <% if (locals.user && locals.yaComprado) { %>
                        <p class="fx-alert is-ok" style="margin-bottom: 1rem;">Ya estás inscripto en este curso.</p>
                        <a href="/classroom/<%= curso.id %>" class="fx-btn fx-btn--solid">Ir al aula</a>
                    <% } else { %>
                        <p class="fx-price fx-course__price">$<%= curso.precio %><small>ARS · pago único</small></p>
                        <% if (locals.user) { %>
                            <div class="fx-course__code">
                                <label for="codigo-descuento" class="fx-hint" style="margin: 0 0 0.4rem; display: block;">¿Tenés un código de descuento?</label>
                                <div class="fx-course__code-row">
                                    <input class="fx-input" type="text" id="codigo-descuento" placeholder="Código" autocomplete="off">
                                    <button type="button" class="fx-btn fx-btn--sm" onclick="validarCodigo()">Aplicar</button>
                                </div>
                                <p id="descuento-mensaje" class="fx-status" role="status"></p>
                                <p id="precio-con-descuento" class="fx-course__discount" style="display: none;"></p>
                            </div>
                            <form action="/checkout/<%= curso.id %>" method="POST" id="checkout-form">
                                <input type="hidden" name="codigo_descuento" id="codigo-descuento-hidden" value="">
                                <button type="submit" class="fx-btn fx-btn--solid" id="btn-inscribir">Inscribirme · $<%= curso.precio %> ARS</button>
                            </form>
                            <p class="fx-hint" style="margin: 0.8rem 0 0;">Pagás con MercadoPago y entrás al aula enseguida.</p>
                        <% } else { %>
                            <a href="/auth/login" class="fx-btn fx-btn--solid">Iniciá sesión para inscribirte</a>
                            <p class="fx-hint" style="margin: 0.8rem 0 0;">¿No tenés cuenta? <a href="/auth/register" style="color: var(--fx-steel);">Creala en un minuto</a>.</p>
                        <% } %>
                    <% } %>
                </div>
            </div>
        </div>

        <% if (esIntensivo) { %>
        <section class="fx-course__more">
            <div class="fx-block__head">
                <h2>Qué <span class="fx-steel">incluye</span></h2>
            </div>

            <div class="fx-course__grid">
                <div class="fx-panel">
                    <h3 class="fx-course__h3">Entregas en cada clase</h3>
                    <p>Cada clase tiene actividades para entregar. Al completarlas, se habilita la siguiente.</p>
                </div>
                <div class="fx-panel">
                    <h3 class="fx-course__h3">Corrección personalizada</h3>
                    <p>El profesor corrige cada entrega a mano y te manda una devolución con nota.</p>
                </div>
                <div class="fx-panel">
                    <h3 class="fx-course__h3">Certificado A1–A2</h3>
                    <p>Al aprobar el curso descargás tu certificado de nivel A1–A2.</p>
                </div>
            </div>

            <ul class="fx-checks" style="margin-top: 1.8rem;">
                <li>10 clases progresivas con contenido interactivo y ejercicios.</li>
                <li>Seguimiento individual del profesor en cada entrega.</li>
                <li>Aula virtual abierta las 24 horas para avanzar a tu ritmo.</li>
                <li>Certificado descargable al aprobar la evaluación final.</li>
            </ul>
        </section>
        <% } %>
    </main>

    <%- include('partials/footer') %>

    <script>
        function validarCodigo() {
            const codigo = document.getElementById('codigo-descuento').value.trim();
            const mensaje = document.getElementById('descuento-mensaje');
            const precioConDescuento = document.getElementById('precio-con-descuento');
            const precioOriginal = <%= curso.precio %>;

            mensaje.classList.remove('is-error');
            if (!codigo) {
                mensaje.textContent = '';
                precioConDescuento.style.display = 'none';
                document.getElementById('codigo-descuento-hidden').value = '';
                actualizarBotonPrecio(precioOriginal);
                return;
            }

            // Validar código con el servidor
            fetch('/validar-codigo-descuento', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ codigo: codigo })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    const precioFinal = Math.floor(precioOriginal * (1 - data.porcentaje / 100));
                    mensaje.textContent = data.mensaje;
                    precioConDescuento.innerHTML = '<s>$' + precioOriginal + '</s> $' + precioFinal + ' ARS';
                    precioConDescuento.style.display = 'block';
                    document.getElementById('codigo-descuento-hidden').value = codigo;
                    actualizarBotonPrecio(precioFinal);
                } else {
                    mensaje.textContent = data.message;
                    mensaje.classList.add('is-error');
                    precioConDescuento.style.display = 'none';
                    document.getElementById('codigo-descuento-hidden').value = '';
                    actualizarBotonPrecio(precioOriginal);
                }
            })
            .catch(error => {
                mensaje.textContent = 'No se pudo validar el código. Probá de nuevo.';
                mensaje.classList.add('is-error');
                console.error('Error al validar código:', error);
            });
        }

        function actualizarBotonPrecio(precio) {
            const btn = document.getElementById('btn-inscribir');
            if (btn) btn.textContent = 'Inscribirme · $' + precio + ' ARS';
        }

        // Validar cuando el usuario presiona Enter en el campo de código
        const campoCodigo = document.getElementById('codigo-descuento');
        if (campoCodigo) {
            campoCodigo.addEventListener('keydown', function (e) {
                if (e.key === 'Enter') { e.preventDefault(); validarCodigo(); }
            });
        }
    </script>
</body>
</html>
