<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= curso ? curso.titulo : 'Detalle del Curso' %> - INGLÉS SUEZ</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=GFS+Didot&family=Tenor+Sans&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/styles.css">
    <style>
        body, p, span, div, a, li, button { font-family: 'GFS Didot', serif; }
        h1, h2, h3, h4, h5, h6 { font-family: 'Tenor Sans', sans-serif !important; }
        body { background-color: #e3edf5; margin: 0; padding: 0; color: #1a202c; }
        .card-header-logo { background: #d3e4f2; padding: 2.5rem 1rem; text-align: center; border-bottom: 2px solid #b2cce0; }
        .card-header-logo img { height: 120px; width: auto; object-fit: contain; }
    </style>
</head>
<body>

    <%- include('partials/header') %>

    <main style="max-width: 900px; margin: 3.5rem auto; padding: 0 1.5rem;">
        <% if (curso) { %>
            <div style="background: white; border-radius: 12px; overflow: hidden; box-shadow: 0 12px 30px rgba(11, 34, 56, 0.12), 0 4px 8px rgba(0, 0, 0, 0.04); border: 1px solid #c0d4e5;">
                
                <div class="card-header-logo">
                    <img src="/img/logo.jpg" alt="INGLÉS SUEZ">
                </div>

                <div style="padding: 2.5rem;">
                    <h1 style="color: #0b2238; font-size: 2.2rem; margin-top: 0; margin-bottom: 1rem;"><%= curso.titulo %></h1>
                    
                    <p style="color: #4a5568; font-size: 1.1rem; line-height: 1.7; margin-bottom: 2rem;">
                        <%= curso.descripcion %>
                    </p>

                    <div style="background: #f0f6fa; border-radius: 8px; padding: 1.5rem; margin-bottom: 2.5rem; border: 1px solid #c0d4e5;">
                        <h3 style="color: #0b2238; margin-top: 0; margin-bottom: 0.8rem; font-size: 1.2rem;">¿Qué incluye este programa?</h3>
                        <ul style="color: #184168; margin: 0; padding-left: 1.2rem; line-height: 1.8; font-size: 1.05rem;">
                            <li>Acceso ilimitado de por vida a las videoclases.</li>
                            <li>Materiales complementarios en PDF para descargar.</li>
                            <li>Ejercicios prácticos de pronunciación y gramática.</li>
                            <li>Certificado de finalización oficial.</li>
                        </ul>
                    </div>

                    <div style="display: flex; justify-content: space-between; align-items: center; border-top: 2px solid #e2ebd5; padding-top: 1.5rem;">
                        <div>
                            <span style="font-size: 0.8rem; color: #718096; text-transform: uppercase; display: block;">Inversión Total</span>
                            <span style="color: #0b2238; font-size: 1.8rem; font-weight: bold; font-family: 'Tenor Sans', sans-serif;">$<%= curso.precio %> ARS</span>
                        </div>

                        <% if (locals.user) { %>
                            <form action="/checkout/<%= curso.id %>" method="POST">
                                <button type="submit" style="background: #0b2238; color: white; padding: 0.9rem 2rem; border-radius: 6px; border: none; font-size: 1rem; cursor: pointer; font-family: 'Tenor Sans', sans-serif;">
                                    Inscribirme Ahora
                                </button>
                            </form>
                        <% } else { %>
                            <a href="/auth/login" style="background: #0b2238; color: white; padding: 0.9rem 2rem; border-radius: 6px; text-decoration: none; font-size: 1rem; font-family: 'Tenor Sans', sans-serif;">
                                Inicia Sesión para Inscribirte
                            </a>
                        <% } %>
                    </div>
                </div>

            </div>
        <% } else { %>
            <div style="background: white; border-radius: 12px; padding: 3rem; text-align: center; box-shadow: 0 10px 25px rgba(11, 34, 56, 0.12);">
                <h2 style="color: #0b2238;">Curso no encontrado</h2>
                <a href="/" style="color: #184168; font-weight: bold;">Volver al Inicio</a>
            </div>
        <% } %>
    </main>

    <%- include('partials/footer') %>

</body>
</html>