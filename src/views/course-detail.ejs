<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= curso.titulo %> - INGLÉS SUEZ</title>
    <link rel="stylesheet" href="/css/styles.css">
    <style>
        .course-detail-container {
            max-width: 900px;
            margin: 3rem auto;
            padding: 2rem;
            background: #ffffff;
            border-radius: 8px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
            border: 1px solid #e2e8f0;
        }
        .btn-action {
            display: inline-block;
            padding: 0.9rem 1.8rem;
            border-radius: 6px;
            font-weight: bold;
            font-size: 1rem;
            text-decoration: none;
            cursor: pointer;
            border: none;
            transition: background 0.2s;
        }
        .btn-primary { background: #184168; color: #ffffff; }
        .btn-primary:hover { background: #0b2238; }
        .btn-success { background: #0b2238; color: #ffffff; }
        .btn-success:hover { background: #184168; }
    </style>
</head>
<body>

    <%- include('partials/header') %>

    <main class="course-detail-container">
        <div style="display: flex; gap: 2rem; align-items: center; flex-wrap: wrap;">
            <% if (curso.imagen_url) { %>
                <img src="<%= curso.imagen_url %>" alt="<%= curso.titulo %>" style="max-width: 280px; border-radius: 8px;">
            <% } %>

            <div style="flex: 1;">
                <span style="background: #e2ebd5; color: #184168; padding: 0.3rem 0.8rem; border-radius: 4px; font-size: 0.8rem; font-weight: bold; text-transform: uppercase;">
                    Curso Oficial
                </span>

                <h1 style="color: #0b2238; margin-top: 0.8rem; margin-bottom: 0.5rem;"><%= curso.titulo %></h1>
                <p style="color: #4a5568; font-size: 1.05rem; line-height: 1.6;"><%= curso.descripcion %></p>

                <div style="margin-top: 1.8rem;">
                    <% if (locals.yaComprado) { %>
                        <!-- Opción A: Usuario ya inscripto -->
                        <a href="/classroom/<%= curso.id %>" class="btn-action btn-primary">
                            Ir al Aula Virtual
                        </a>
                    <% } else { %>
                        <!-- Opción B: Usuario no inscripto -->
                        <form action="/checkout/<%= curso.id %>" method="POST" style="display: inline;">
                            <button type="submit" class="btn-action btn-success">
                                Inscribirme en curso
                            </button>
                        </form>
                    <% } %>
                </div>
            </div>
        </div>
    </main>

    <%- include('partials/footer') %>

</body>
</html>