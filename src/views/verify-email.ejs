<!DOCTYPE html>
<html lang="es">
<head>
    <link rel="icon" type="image/svg+xml" href="/img/favicon-suez.svg">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Verificá tu email · Inglés Suez</title>
</head>
<body class="tema-flyer">
    <%- include('partials/header') %>

    <main class="fx-auth">
        <div class="fx-auth__card">
            <%- include('partials/auth-star') %>
            <% if (success) { %>
                <span class="fx-auth__icon is-ok" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg></span>
                <h1 class="fx-auth__title">¡Cuenta <span class="fx-steel">verificada!</span></h1>
                <p class="fx-alert is-ok" role="status"><%= success %></p>
                <a href="/auth/login" class="fx-btn fx-btn--solid" style="width: 100%; justify-content: center;">Iniciar sesión</a>
            <% } else if (error) { %>
                <span class="fx-auth__icon is-error" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M12 7v6"/><path d="M12 17h.01"/><circle cx="12" cy="12" r="9.5"/></svg></span>
                <h1 class="fx-auth__title">No pudimos <span class="fx-steel">verificarla</span></h1>
                <p class="fx-alert is-error" role="alert"><%= error %></p>
            <% } else { %>
                <span class="fx-auth__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="M3.5 6.5l8.5 6.5 8.5-6.5"/></svg></span>
                <h1 class="fx-auth__title">Revisá tu <span class="fx-steel">email</span></h1>
                <p class="fx-auth__lead">Te mandamos un enlace para activar tu cuenta. Abrilo desde tu correo y listo.</p>
                <% if (email) { %>
                    <p class="fx-auth__email"><%= email %></p>
                <% } %>
            <% } %>

            <% if (!success && email) { %>
                <form action="/auth/resend-verification" method="POST" style="margin-top: 0.4rem;">
                    <p class="fx-hint" style="margin: 0 0 0.8rem;">¿No te llegó? Mirá en spam o pedilo de nuevo.</p>
                    <input type="hidden" name="email" value="<%= email %>">
                    <button type="submit" class="fx-btn">Reenviar el email</button>
                </form>
            <% } %>

            <p class="fx-auth__foot"><a href="/auth/login">Iniciar sesión</a> &nbsp;·&nbsp; <a href="/">Volver al inicio</a></p>
        </div>
    </main>

    <%- include('partials/footer') %>
</body>
</html>
