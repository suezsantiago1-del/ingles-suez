<!DOCTYPE html>
<html lang="es">
<head>
    <link rel="icon" type="image/svg+xml" href="/img/favicon-suez.svg">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gestión de cursos · Panel del profesor · Inglés Suez</title>
</head>
<body class="tema-flyer">

    <%- include('partials/header') %>

    <main class="fx-page fx-gestion">
        <%- include('partials/teacher-tabs', { activa: '/profesor/gestion' }) %>

        <div class="fx-block__head" style="margin: 2.2rem 0 1.6rem;">
            <h1 class="fx-page__title">Gestión <span class="fx-steel">de cursos</span></h1>
            <p>Videos, anuncios, notas por clase y el texto de bienvenida del aula.</p>
        </div>

        <div class="fx-gestion__grid">
            <!-- Videos de las clases -->
            <section id="video-management" class="fx-panel">
                <h2>Videos de las clases</h2>
                <p>Elegí la clase y pegá el link de YouTube.<% if (allowLocalVideoUpload) { %> También podés subir un MP4.<% } %></p>
                <div class="fx-field">
                    <label for="select-leccion">Clase</label>
                    <select id="select-leccion" class="fx-input">
                        <option value="">Elegí una clase</option>
                    </select>
                </div>
                <div class="fx-field">
                    <label for="input-video-url">Link del video</label>
                    <input id="input-video-url" class="fx-input" type="text" placeholder="https://youtube.com/watch?v=…" />
                </div>
                <% if (allowLocalVideoUpload) { %>
                <div class="fx-field">
                    <label for="input-video-file">O subí un archivo</label>
                    <input id="input-video-file" class="fx-input" type="file" accept="video/mp4,video/*" />
                </div>
                <% } %>
                <button id="btn-upload-video" type="button" class="fx-btn fx-btn--solid fx-btn--sm">Guardar video</button>
                <p id="video-management-feedback" class="fx-status" role="status" style="display: none;"></p>
            </section>

            <!-- Anuncios -->
            <section id="announcements-management" class="fx-panel">
                <h2>Anuncio del curso</h2>
                <p>Lo ven todos los alumnos del curso arriba de cada clase.</p>
                <div class="fx-field">
                    <label for="select-course-ann">Curso</label>
                    <select id="select-course-ann" class="fx-input"></select>
                </div>
                <div class="fx-field">
                    <label for="announcement-text">Anuncio</label>
                    <textarea id="announcement-text" class="fx-input" rows="4" placeholder="Escribí el anuncio para este curso"></textarea>
                </div>
                <div class="fx-gestion__actions">
                    <button id="btn-save-ann" type="button" class="fx-btn fx-btn--solid fx-btn--sm">Guardar anuncio</button>
                    <button id="btn-delete-ann" type="button" class="fx-btn fx-btn--sm fx-btn--danger">Eliminar</button>
                </div>
                <p id="ann-feedback" class="fx-status" role="status" style="display: none;"></p>
            </section>

            <!-- Notas por clase -->
            <section id="lesson-note-management" class="fx-panel fx-gestion__wide">
                <h2>Notas por clase</h2>
                <p>Una nota que los alumnos ven dentro de esa clase, arriba del contenido.</p>
                <div class="fx-gestion__cols">
                    <div>
                        <div class="fx-field">
                            <label for="select-lesson-note">Clase</label>
                            <select id="select-lesson-note" class="fx-input"></select>
                        </div>
                        <div class="fx-field">
                            <label for="lesson-teacher-note">Nota</label>
                            <textarea id="lesson-teacher-note" class="fx-input" rows="4" placeholder="Escribí la nota para esta clase"></textarea>
                        </div>
                        <button id="btn-save-lesson-note" type="button" class="fx-btn fx-btn--solid fx-btn--sm">Guardar nota</button>
                        <p id="lesson-note-feedback" class="fx-status" role="status" style="display: none;"></p>
                    </div>

                    <div>
                        <h3 class="fx-gestion__h3">Notas guardadas</h3>
                        <% const leccionesConNota = lecciones.filter(l => l.teacher_note); %>
                        <% if (leccionesConNota.length > 0) { %>
                            <% leccionesConNota.forEach(l => { %>
                                <div id="nota-item-<%= l.leccion_id %>" class="fx-gestion__nota">
                                    <div style="min-width: 0;">
                                        <strong>Clase <%= l.orden %> · <%= l.leccion_titulo %></strong>
                                        <p><%= l.teacher_note %></p>
                                    </div>
                                    <button type="button" class="fx-btn fx-btn--sm fx-btn--danger" onclick="eliminarNotaLeccion(<%= l.leccion_id %>)">Quitar</button>
                                </div>
                            <% }) %>
                        <% } %>
                        <p id="sin-notas-msg" class="fx-status" style="<%= leccionesConNota.length > 0 ? 'display: none;' : '' %> color: var(--fx-muted);">Todavía no hay notas guardadas.</p>
                    </div>
                </div>
            </section>

            <% const bienvenida = lecciones.find(l => l.orden === 0); %>
            <% if (bienvenida) { %>
            <!-- Texto de bienvenida (lección "Welcome!", orden 0) -->
            <section id="bienvenida-management" class="fx-panel fx-gestion__wide">
                <h2>Texto de bienvenida</h2>
                <p>Lo que ven los alumnos al entrar por primera vez al aula (la clase "Welcome!"). Acepta HTML.</p>
                <div class="fx-gestion__cols">
                    <div>
                        <label for="textarea-bienvenida" class="fx-sr">Texto de bienvenida</label>
                        <textarea id="textarea-bienvenida" class="fx-input fx-gestion__code" rows="12" placeholder="Escribí el texto de bienvenida"><%= bienvenida.contenido_html %></textarea>
                        <div class="fx-gestion__actions" style="margin-top: 0.8rem;">
                            <button id="btn-guardar-bienvenida" type="button" class="fx-btn fx-btn--solid fx-btn--sm">Guardar bienvenida</button>
                            <span id="bienvenida-feedback" class="fx-status" style="display: none; margin: 0;"></span>
                        </div>
                    </div>
                    <div>
                        <h3 class="fx-gestion__h3">Vista previa</h3>
                        <div id="vista-previa-bienvenida" class="fx-gestion__preview"></div>
                    </div>
                </div>
            </section>
            <% } %>
        </div>
    </main>

    <%- include('partials/footer') %>

    <script>
// Array global recibido de EJS
        const leccionesGlobal = <%- JSON.stringify(typeof lecciones !== 'undefined' ? lecciones : []) %>;
        const anunciosGlobal = <%- JSON.stringify(typeof anuncios !== 'undefined' ? anuncios : []) %>;

        // --- Edición del texto de bienvenida (lección orden 0) ---
        const leccionBienvenidaGlobal = <%- JSON.stringify(typeof lecciones !== 'undefined' ? (lecciones.find(l => l.orden === 0) || null) : null) %>;
        (function initBienvenida(){
            if (!leccionBienvenidaGlobal) return;
            const textarea = document.getElementById('textarea-bienvenida');
            const btn = document.getElementById('btn-guardar-bienvenida');
            const fb = document.getElementById('bienvenida-feedback');
            const prev = document.getElementById('vista-previa-bienvenida');
            if (!textarea || !btn || !prev) return;
            function updatePrev(){ prev.innerHTML = textarea.value; }
            textarea.addEventListener('input', updatePrev);
            updatePrev();
            btn.addEventListener('click', async () => {
                btn.disabled = true; btn.innerText = 'Guardando...';
                try {
                    const resp = await fetch('/profesor/leccion/contenido', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ leccionId: leccionBienvenidaGlobal.leccion_id, contenido: textarea.value }) });
                    const data = await resp.json();
                    if (data.success) {
                        fb.style.display = 'inline'; fb.innerText = 'Guardado ✓';
                        setTimeout(() => { fb.style.display = 'none'; }, 2000);
                    } else {
                        alert(data.message || 'Error al guardar el texto de bienvenida.');
                    }
                } catch (err) { console.error(err); alert('Error de conexión al guardar.'); }
                finally { btn.disabled = false; btn.innerText = 'Guardar Bienvenida'; }
            });
        })();

        (function initVideoManagement(){
            const select = document.getElementById('select-leccion');
            if (!select) return;

            leccionesGlobal.forEach(l => {
                const opt = document.createElement('option');
                opt.value = l.leccion_id;
                opt.text = `${l.curso_titulo} — ${l.leccion_titulo} (orden ${l.orden})`;
                select.appendChild(opt);
            });

            const btn = document.getElementById('btn-upload-video');
            btn.addEventListener('click', async () => {
                const leccionId = select.value;
                const videoUrl = document.getElementById('input-video-url').value.trim();
                const fileInput = document.getElementById('input-video-file');

                if (!leccionId) { alert('Selecciona una lección.'); return; }

                const formData = new FormData();
                formData.append('leccionId', leccionId);
                if (videoUrl) formData.append('videoUrl', videoUrl);
                if (fileInput && fileInput.files && fileInput.files[0]) formData.append('videoFile', fileInput.files[0]);

                btn.disabled = true; btn.innerText = 'Guardando...';

                try {
                    const resp = await fetch('/profesor/leccion/video', { method: 'POST', body: formData });
                    const data = await resp.json();
                    const fb = document.getElementById('video-management-feedback');

                    if (data.success) {
                        fb.style.display = 'block';
                        fb.style.color = '#B9E3C6';
                        fb.innerText = 'Video guardado correctamente.';
                        const found = leccionesGlobal.find(x => x.leccion_id == leccionId);
                        if (found) found.video_url = data.video_url;
                    } else {
                        alert(data.message || 'Error al guardar el video');
                    }
                } catch (err) {
                    console.error(err);
                    alert('Error de conexión al subir el video.');
                } finally {
                    btn.disabled = false; btn.innerText = 'Guardar Video';
                }
            });
        })();
// --- Announcements management logic ---
        (function initAnnouncements(){
            const select = document.getElementById('select-course-ann');
            const textarea = document.getElementById('announcement-text');
            const btnSave = document.getElementById('btn-save-ann');
            const btnDelete = document.getElementById('btn-delete-ann');
            const fb = document.getElementById('ann-feedback');

            if (!select || !textarea || !btnSave || !btnDelete) return;

            const coursesMap = new Map();
            leccionesGlobal.forEach(l => {
                if (!coursesMap.has(l.curso_id)) coursesMap.set(l.curso_id, { id: l.curso_id, titulo: l.curso_titulo });
            });

            coursesMap.forEach(c => {
                const opt = document.createElement('option');
                opt.value = c.id;
                opt.text = c.titulo;
                select.appendChild(opt);
            });

            function loadForCourse(courseId) {
                const found = anunciosGlobal.find(a => parseInt(a.curso_id, 10) === parseInt(courseId, 10));
                if (found) {
                    textarea.value = found.mensaje || '';
                    textarea.dataset.annId = found.id;
                    btnDelete.disabled = false;
                } else {
                    textarea.value = '';
                    delete textarea.dataset.annId;
                    btnDelete.disabled = true;
                }
            }

            select.addEventListener('change', () => loadForCourse(select.value));
            if (select.options.length > 0) loadForCourse(select.options[0].value);

            btnSave.addEventListener('click', async () => {
                const curso_id = select.value;
                const mensaje = textarea.value.trim();
                if (!curso_id) { alert('Selecciona un curso'); return; }
                if (!mensaje) { alert('Escribe el anuncio antes de guardar'); return; }
                btnSave.disabled = true; btnSave.innerText = 'Guardando...';

                const payload = { curso_id, mensaje };
                if (textarea.dataset.annId) payload.id = textarea.dataset.annId;

                try {
                    const resp = await fetch('/profesor/anuncio', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
                    const data = await resp.json();
                    if (data.success) {
                        fb.style.display = 'block'; fb.innerText = data.message || 'Anuncio guardado';
                        setTimeout(()=>{ fb.style.display='none'; }, 2000);
                        window.location.reload();
                    } else {
                        alert(data.message || 'Error al guardar anuncio');
                    }
                } catch (err) {
                    console.error(err); alert('Error de conexión al guardar anuncio');
                } finally {
                    btnSave.disabled = false; btnSave.innerText = 'Guardar Anuncio';
                }
            });

            btnDelete.addEventListener('click', async () => {
                const annId = textarea.dataset.annId;
                if (!annId) return;
                if (!confirm('¿Eliminar este anuncio?')) return;
                btnDelete.disabled = true; btnDelete.innerText = 'Eliminando...';
                try {
                    const resp = await fetch('/profesor/anuncio', { method: 'DELETE', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id: annId }) });
                    const data = await resp.json();
                    if (data.success) { window.location.reload(); } else { alert(data.message || 'Error al eliminar anuncio'); }
                } catch (err) { console.error(err); alert('Error de conexión al eliminar anuncio'); }
            });
        })();

        // --- Per-lesson notes management logic ---
        (function initLessonNotes(){
const select = document.getElementById('select-lesson-note');
            const textarea = document.getElementById('lesson-teacher-note');
            const btnSave = document.getElementById('btn-save-lesson-note');
            const fb = document.getElementById('lesson-note-feedback');

            if (!select || !textarea || !btnSave) return;

            leccionesGlobal.forEach(l => {
                const opt = document.createElement('option');
                opt.value = l.leccion_id;
                opt.text = `Clase ${l.orden} — ${l.leccion_titulo}`;
                select.appendChild(opt);
            });

            function loadSelected() {
                const sel = select.value;
                const found = leccionesGlobal.find(x => String(x.leccion_id) === String(sel));
                textarea.value = found ? (found.teacher_note || '') : '';
            }

            select.addEventListener('change', loadSelected);
            if (select.options.length > 0) loadSelected();

            btnSave.addEventListener('click', async () => {
                const leccionId = select.value;
                const note = textarea.value.trim();
                if (!leccionId) { alert('Selecciona una lección'); return; }
                btnSave.disabled = true; btnSave.innerText = 'Guardando...';

                try {
                    const resp = await fetch('/profesor/leccion/nota', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ leccionId, note }) });
                    const data = await resp.json();
                    if (data.success) {
                        fb.style.display = 'block'; fb.innerText = data.message || 'Nota guardada';
                        setTimeout(()=>{ fb.style.display='none'; }, 1500);
                        const found = leccionesGlobal.find(x => String(x.leccion_id) === String(leccionId));
                        if (found) found.teacher_note = note;
                    } else {
                        alert(data.message || 'Error al guardar la nota de la lección');
                    }
                } catch (err) { console.error(err); alert('Error de conexión al guardar la nota'); }
                finally { btnSave.disabled = false; btnSave.innerText = 'Guardar Nota de Lección'; }
            });
        })();

        // Eliminar la nota de una lección (desde "Notas guardadas")
        function eliminarNotaLeccion(leccionId) {
            if (!confirm('¿Eliminar la nota de esta lección?')) return;
            fetch('/profesor/leccion/nota/eliminar', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ leccionId })
            })
                .then(r => r.json())
                .then(data => {
                    if (data.success) {
                        const item = document.getElementById('nota-item-' + leccionId);
                        if (item) item.remove();
                        const msg = document.getElementById('sin-notas-msg');
                        if (msg) msg.style.display = 'block';
                        alert('Nota eliminada.');
                        window.location.reload();
                    } else {
                        alert(data.message || 'No se pudo eliminar la nota.');
                    }
                })
                .catch(() => alert('Error de conexión al eliminar la nota.'));
        }
    </script>
</body>
</html>