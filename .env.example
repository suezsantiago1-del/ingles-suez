# Copiar este archivo a .env y completar los valores.
# En Render estas mismas variables se cargan desde el dashboard (Environment).

# ==========================================
# BASE DE DATOS (PostgreSQL) - OBLIGATORIA
# ==========================================
# La app no arranca sin esto.
# En desarrollo usar SIEMPRE una base distinta a la de produccion.
DATABASE_URL=postgresql://usuario:password@localhost:5432/ingles_suez

# ==========================================
# SEGURIDAD
# ==========================================
SESSION_SECRET=cambiar_por_una_cadena_larga_y_aleatoria

# Email de la cuenta con permisos de profesor (acceso a /profesor/*).
EMAIL_PROFESOR=suezsantiago1@gmail.com

# ==========================================
# MERCADO PAGO
# ==========================================
# Sin esto la app levanta igual, pero el checkout falla.
MP_ACCESS_TOKEN=

# ==========================================
# EMAIL (SMTP) - Brevo
# ==========================================
# 1. Cuenta gratis en https://www.brevo.com
# 2. "SMTP & API" en el menu lateral -> copiar la SMTP Key (xkeysib-...)
# 3. Verificar el remitente en "Senders & IP" -> "Senders" -> "Add a sender"
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="INGLES SUEZ" <noreply@inglessuez.com>

# Alternativa solo para pruebas (los mails no llegan al correo real,
# quedan en un inbox virtual): https://mailtrap.io
# SMTP_HOST=sandbox.smtp.mailtrap.io
# SMTP_PORT=2525

# ==========================================
# OPCIONALES
# ==========================================
# PORT=3000
# UPLOADS_DIR=./public/videos
# NODE_ENV=production
