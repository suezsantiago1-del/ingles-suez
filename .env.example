# ==========================================
# CONFIGURACIÓN DE EMAIL (SMTP) - BREVO
# ==========================================
# Para producción real (los emails llegan al correo del alumno):
#
# 1. Creá tu cuenta gratis en https://www.brevo.com
# 2. Confirmá tu email
# 3. Andá a "SMTP & API" en el menú lateral
# 4. Copiá tu SMTP Key (es un código largo tipo: xkeysib-xxxxxxxxxxxxxxxx)
# 5. Reemplazá SMTP_PASS abajo con tu SMTP Key
#
# También verificá tu remitente en:
# "Senders & IP" -> "Senders" -> "Add a sender"
# (Validá que sos vos usando suezsantiago1@gmail.com como remitente)


# ==========================================
# OPCIÓN B: Mailtrap Testing (solo pruebas)
# ==========================================
# Los emails se capturan en el inbox virtual, NO llegan al correo real.
# Config: https://mailtrap.io -> Email Testing -> Inboxes -> My Inbox
#
# SMTP_HOST=sandbox.smtp.mailtrap.io
# SMTP_PORT=2525
# SMTP_USER=tu_username
# SMTP_PASS=tu_password
# EMAIL_FROM="INGLÉS SUEZ" <noreply@ingleessuez.com>

# ==========================================
# BASE DE DATOS (PostgreSQL)
# ==========================================
DATABASE_URL=postgresql://usuario:password@localhost:5432/ingles_suez

# ==========================================
# MERCADO PAGO
# ==========================================
MP_ACCESS_TOKEN=

# ==========================================
# SEGURIDAD
# ==========================================
SESSION_SECRET=clave_secreta_suez