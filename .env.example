# Copiar este archivo a .env y completar los valores.
#
# En el VPS este archivo vive en /opt/apps/inglessuez/.env y NUNCA se commitea.
# Ver DEPLOY.md.

# ==========================================
# BASE DE DATOS
# ==========================================
# En desarrollo: la URL completa de tu Postgres local. OBLIGATORIA, la app no
# arranca sin esto. Usar SIEMPRE una base distinta a la de producción — al
# arrancar, database.js crea tablas, corre ALTER TABLE y siembra las lecciones.
DATABASE_URL=postgresql://usuario:password@localhost:5432/ingles_suez

# En el VPS NO se completa DATABASE_URL acá: la arma docker-compose.prod.yml a
# partir de estas tres, para no tener la contraseña escrita dos veces.
# Si la contraseña lleva @ : / o ?, hay que URL-encodearlos.
POSTGRES_USER=inglessuez
POSTGRES_PASSWORD=
POSTGRES_DB=inglessuez

# TLS contra la base. En Render/Neon la conexión sale a internet y va en
# 'true'. En el VPS, Postgres corre en la red interna de Docker y no habla
# TLS: forzarlo hace fallar el arranque con "The server does not support SSL
# connections". El compose de producción ya la fija en "false".
DATABASE_SSL=false

# ==========================================
# SEGURIDAD
# ==========================================
# Firma las cookies de sesión: con un valor conocido, cualquiera puede
# fabricar la sesión de cualquier alumno. Con NODE_ENV=production la app se
# niega a arrancar si falta.
#   openssl rand -base64 48
SESSION_SECRET=cambiar_por_una_cadena_larga_y_aleatoria

# Email de la cuenta con permisos de profesor (acceso a /profesor/*).
EMAIL_PROFESOR=suezsantiago1@gmail.com

# ==========================================
# MERCADO PAGO
# ==========================================
# Sin esto la app levanta igual, pero el checkout falla.
MP_ACCESS_TOKEN=

# ==========================================
# EMAIL — Brevo
# ==========================================
# Se manda por la API HTTP de Brevo (sib-api-v3-sdk), NO por SMTP: no hay
# conexión saliente al puerto 587 y no hace falta configurar host ni puerto.
#
# 1. Cuenta gratis en https://www.brevo.com
# 2. "SMTP & API" en el menú lateral -> copiar la API key (xkeysib-...)
# 3. Verificar el remitente en "Senders & IP" -> "Senders" -> "Add a sender"
BREVO_API_KEY=

# SMTP_PASS se sigue leyendo como fallback de BREVO_API_KEY por compatibilidad
# con el deploy viejo de Render. En una instalación nueva usar BREVO_API_KEY.
# SMTP_PASS=

# Desde qué dirección salen los mails. TIENE que ser de un dominio autenticado
# en Brevo (DKIM + SPF), no un gmail: sobre gmail.com no se puede publicar la
# clave DKIM porque el DNS es de Google, así que el mail falla la alineación
# DMARC y cae en spam. Y acá el mail de verificación es lo que habilita la
# cuenta del alumno.
EMAIL_REMITENTE=no-responder@inglesuez.com
EMAIL_REMITENTE_NOMBRE=INGLÉS SUEZ

# A dónde van las respuestas, porque no-responder@ no tiene casilla.
# Si no se define, usa EMAIL_PROFESOR.
# EMAIL_RESPUESTAS=suezsantiago1@gmail.com

# ==========================================
# VIDEOS
# ==========================================
# Los videos de las lecciones van por YouTube: se sube el video como "no
# listado" y se pega el link en el campo de URL del panel del profesor. La app
# normaliza los links de watch/youtu.be a /embed/ sola.
#
# Con esto en 'true' vuelve a aparecer el input de archivo del panel y los
# videos se guardan en el disco del servidor. NO activar en el VPS: el
# contenedor no monta volumen para videos, así que el archivo se escribiría en
# la capa efímera y desaparecería en el próximo redeploy.
ALLOW_LOCAL_VIDEO_UPLOAD=false

# Tamaño máximo por archivo, en MB. Solo aplica si el anterior está en 'true'.
# MAX_VIDEO_MB=500

# Carpeta donde se guardan esos archivos. Default: public/videos
# UPLOADS_DIR=./public/videos

# ==========================================
# DATOS DE PRUEBA (solo desarrollo)
# ==========================================
# En 'true' carga los usuarios de test, los inscribe en un curso y resetea
# las notas del profesor. Ver src/config/devSeeds.js.
# NO activar en producción: se ignora si NODE_ENV=production.
SEED_TEST_DATA=false

# ==========================================
# OPCIONALES
# ==========================================
# PORT=3000
# NODE_ENV=production
